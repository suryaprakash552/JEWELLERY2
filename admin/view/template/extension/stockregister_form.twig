<div class="card panel panel-default" style="margin-top: 20px;">
  <div class="card-header panel-heading d-flex justify-content-between align-items-center" style="background: #fff;">
    <h3 class="card-title panel-title m-0" style="font-size: 16px; font-weight: 600;"><i class="fa fa-barcode"></i> Product Create Page - Batch: {{ selected_batch }}</h3>
    <div style="font-size: 12px; font-weight: 600; color: #64748b; display: inline-flex; align-items: center; gap: 8px;">
      SETTINGS: WP-Add % <input type="text" value="20" style="width: 40px; text-align: center; border: 1px solid #ccc; border-radius: 4px; padding: 2px;"> 
      RP-Add % <input type="text" value="20" style="width: 40px; text-align: center; border: 1px solid #ccc; border-radius: 4px; padding: 2px; margin-right: 10px;">
      <button type="button" data-toggle="tooltip" title="Delete" class="btn btn-danger btn-custom-delete" onclick="deleteSelectedProducts()"><i class="fa-solid fa-trash-can text-white"></i> Delete</button>
    </div>
  </div>
  
  <div class="table-responsive">
    <table class="table table-bordered table-hover" style="margin-bottom: 0; background: #fff;">
      <thead style="background: #f8f9fa;">
        <tr>
          <td style="width: 1px; text-align: center;"><input type="checkbox" onclick="$('input[name*=\'selected_products\']').prop('checked', this.checked);" /></td>
          <td class="text-center font-bold">SRNO</td>
          <td class="text-center font-bold">Batch No</td>
          <td class="text-center font-bold">Box ID / Product Name</td>
          <td class="text-center font-bold">Image</td>
          <td class="text-center font-bold">Type / Received Price</td>
          <td class="text-center font-bold">WP / SWP</td>
          <td class="text-center font-bold">RP / SRP</td>
          <td class="text-center font-bold">Quantity</td>
          <td class="text-center font-bold">Barcode</td>
          <td class="text-center font-bold">Rack</td>
          <td class="text-center font-bold">Creation Date</td>
          <td class="text-center font-bold">Action</td>
        </tr>
      </thead>
      <tbody>
        <!-- Add Form Row -->
        <tr style="background: #fff;">
          <form action="{{ action }}" method="post" id="form-product">
            <td class="text-center" style="vertical-align: middle;">+</td>
            <td class="text-center" style="vertical-align: middle;">+</td>
            <td class="text-center" style="vertical-align: middle;">{{ selected_batch }}</td>
            <td style="vertical-align: middle;">
              <input type="text" name="box_id" placeholder="Box ID" class="form-control form-control-sm mb-1" style="text-align: center; border-radius: 4px; border: 1px solid #3b82f6; color: #3b82f6;">
              <input type="text" name="name" placeholder="Product Name" class="form-control form-control-sm" style="text-align: center; border-radius: 4px; border: 1px solid #3b82f6; color: #3b82f6;" required>
            </td>
            <td class="text-center" style="vertical-align: middle;">
              <button type="button" class="btn" style="background: #1e293b; color: #fff; border-radius: 6px; padding: 10px 5px; font-size: 11px; font-weight: 600; width: 60px; line-height: 1.2;">
                <i class="fa fa-upload" style="font-size: 14px; margin-bottom: 3px;"></i><br>Upload<br>Image
              </button>
            </td>
            <td style="vertical-align: middle;">
              <select name="type" class="form-control form-control-sm mb-1" style="text-align: center; border-radius: 4px; border: 1px solid #3b82f6; color: #3b82f6;">
                <option value="Global">Global</option>
                <option value="Manual">Manual</option>
              </select>
              <input type="text" name="received_price" placeholder="Rec Price" class="form-control form-control-sm" style="text-align: center; border-radius: 4px; border: 1px solid #3b82f6; color: #3b82f6;">
            </td>
            <td style="vertical-align: middle;">
              <input type="text" name="wp" placeholder="0.00" class="form-control form-control-sm mb-1" style="text-align: center; border-radius: 4px; border: 1px solid #3b82f6; color: #3b82f6;">
              <input type="text" name="swp" placeholder="SWP" class="form-control form-control-sm" style="text-align: center; border-radius: 4px; border: 1px solid #3b82f6; color: #3b82f6;">
            </td>
            <td style="vertical-align: middle;">
              <input type="text" name="rp" placeholder="0.00" class="form-control form-control-sm mb-1" style="text-align: center; border-radius: 4px; border: 1px solid #3b82f6; color: #3b82f6;">
              <input type="text" name="srp" placeholder="SRP" class="form-control form-control-sm" style="text-align: center; border-radius: 4px; border: 1px solid #3b82f6; color: #3b82f6;">
            </td>
            <td style="vertical-align: middle;">
              <input type="number" step="0.01" name="quantity" placeholder="Qty" class="form-control form-control-sm" style="text-align: center; border-radius: 4px; border: 1px solid #3b82f6; color: #3b82f6;" required>
            </td>
            <td style="vertical-align: middle;">
              <select name="barcode_type" class="form-control form-control-sm mb-1" style="text-align: center; border-radius: 4px; border: 1px solid #3b82f6; color: #3b82f6;">
                <option value="Unit">Unit</option>
              </select>
              <div class="input-group input-group-sm">
                <input type="text" name="barcode" placeholder="Barcode" class="form-control" style="border-radius: 4px 0 0 4px; border: 1px solid #3b82f6; color: #3b82f6;" required>
                <button type="button" class="btn btn-primary" style="background: #3b82f6; border-color: #3b82f6;"><i class="fa-solid fa-arrows-rotate"></i> Gen</button>
              </div>
            </td>
            <td style="vertical-align: middle;">
              <input type="text" name="rack" placeholder="Rack" class="form-control form-control-sm" style="text-align: center; border-radius: 4px; border: 1px solid #3b82f6; color: #3b82f6;">
            </td>
            <td class="text-center" style="vertical-align: middle; font-size: 12px; color: #64748b;">Today</td>
            <td class="text-center" style="vertical-align: middle;">
              <button type="submit" class="btn btn-success btn-sm" style="width: 100%; border-radius: 4px; font-weight: 600;"><i class="fa-solid fa-floppy-disk" style="margin-right: 4px;"></i> Save</button>
            </td>
          </form>
        </tr>
        
        <!-- Saved Products List -->
        {% if batch_products %}
          {% set p_srno = 1 %}
          {% for product in batch_products %}
            <tr>
              <td class="text-center" style="vertical-align: middle;"><input type="checkbox" name="selected_products[]" value="{{ product.product_id }}" /></td>
              <td class="text-center" style="vertical-align: middle;">{{ p_srno }}</td>
              <td class="text-center" style="vertical-align: middle;">{{ selected_batch }}</td>
              <td class="text-center" style="vertical-align: middle;">
                <div style="font-size: 12px; margin-bottom: 4px;">1</div>
                <div style="font-size: 13px; font-weight: 600;">{{ product.name }}</div>
              </td>
              <td class="text-center" style="vertical-align: middle;">
                <div style="width: 40px; height: 40px; background: #000; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;">
                  <span style="color: #d4af37; font-size: 18px;"><i class="fa fa-certificate"></i></span>
                </div>
              </td>
              <td class="text-center" style="vertical-align: middle;">
                <div style="font-size: 12px; margin-bottom: 4px;">Global</div>
                <div style="font-size: 12px; font-weight: 600; color: #64748b;">₹10.00</div>
              </td>
              <td class="text-center" style="vertical-align: middle;">
                <div style="font-size: 13px; font-weight: 600; margin-bottom: 4px;">₹12.00</div>
                <div style="font-size: 12px; color: #64748b;">S: ₹0.00</div>
              </td>
              <td class="text-center" style="vertical-align: middle;">
                <div style="font-size: 13px; font-weight: 600; margin-bottom: 4px;">₹12.00</div>
                <div style="font-size: 12px; color: #64748b;">S: ₹0.00</div>
              </td>
              <td class="text-center" style="vertical-align: middle; font-weight: 600;">{{ product.quantity }}</td>
              <td class="text-center" style="vertical-align: middle;">
                <div style="font-size: 10px; font-weight: bold;">UNIT</div>
                <img src="https://barcode.orcascan.com/?type=code128&data={{ product.barcode }}" style="height: 20px; max-width: 100px;">
                <div style="font-size: 11px; font-weight: bold;">{{ product.barcode }}</div>
              </td>
              <td class="text-center" style="vertical-align: middle;">11</td>
              <td class="text-center" style="vertical-align: middle; font-size: 12px;">27-May-2026</td>
              <td class="text-center" style="vertical-align: middle;">
                <div class="d-flex justify-content-center" style="gap: 5px;">
                  <button type="button" class="btn btn-info btn-sm" onclick="printBarcode('{{ product.barcode }}', '{{ product.name }}')" style="background: #38bdf8; border: none; color: #fff; border-radius: 4px; padding: 4px 8px; font-size: 12px;"><i class="fa-solid fa-print"></i> Print</button>
                  <button type="button" class="btn btn-warning btn-sm" style="background: #f59e0b; border: none; color: #fff; border-radius: 4px; padding: 4px 8px; font-size: 12px;"><i class="fa-solid fa-pencil"></i> Edit</button>
                  <button type="button" class="btn btn-danger btn-sm" style="background: #ef4444; border: none; border-radius: 4px; padding: 4px 8px; font-size: 12px;"><i class="fa-solid fa-trash-can"></i> Delete</button>
                </div>
              </td>
            </tr>
            {% set p_srno = p_srno + 1 %}
          {% endfor %}
        {% endif %}
      </tbody>
    </table>
  </div>
</div>

{# Print Barcode Modal #}
<div class="modal fade" id="modal-print-barcode" tabindex="-1">
  <div class="modal-dialog modal-sm">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Print Barcode</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body text-center" id="print-area">
        <h6 id="print-name" style="margin-bottom: 10px; font-weight: bold;"></h6>
        <div id="print-barcode-container" style="display: flex; justify-content: center;">
          <img id="print-img" src="" alt="Barcode" style="max-width: 150px; height: auto;">
        </div>
        <div id="print-number" style="margin-top: 5px; letter-spacing: 2px;"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary" onclick="window.print()">Print</button>
      </div>
    </div>
  </div>
</div>

<script>
function printBarcode(barcode, name) {
    document.getElementById('print-name').innerText = name;
    document.getElementById('print-number').innerText = barcode;
    document.getElementById('print-img').src = 'https://barcode.orcascan.com/?type=code128&data=' + encodeURIComponent(barcode);
    var modal = new bootstrap.Modal(document.getElementById('modal-print-barcode'));
    modal.show();
}

function deleteSelectedProducts() {
    var checked = $('input[name*=\'selected_products\']:checked');
    if (checked.length == 0) {
        alert('Please select at least one item to delete.');
        return false;
    }
    if (confirm('Are you sure?')) {
        $.ajax({
            url: 'index.php?route=extension/stockregister.deleteBatchProduct&user_token={{ user_token }}',
            type: 'post',
            data: checked.serialize(),
            dataType: 'json',
            success: function(json) {
                if (json['error']) {
                    alert(json['error']);
                }
                if (json['success']) {
                    if ($('.active-batch-link').length) {
                        $('.active-batch-link').click();
                    } else {
                        location.reload();
                    }
                }
            }
        });
    }
}
</script>

<style>
@media print {
    body * {
        visibility: hidden;
    }
    #print-area, #print-area * {
        visibility: visible;
    }
    #print-area {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
    }
}