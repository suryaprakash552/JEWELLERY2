{{ header }}{{ column_left }}
<div id="content">
	<div class="page-header" style="padding-top: 24px; padding-bottom: 24px; margin-bottom: 0;">
		<div class="container-fluid d-flex justify-content-between align-items-center">
			<h2 style="margin: 0; font-size: 20px; font-weight: 600; line-height: 28px; color: var(--bs-heading-color) !important; font-family: 'Outfit', 'Inter', sans-serif;">POS Batch No</h2>
			<ul class="breadcrumb" style="margin: 0; padding: 0; --bs-breadcrumb-divider: '>';">
				{% for breadcrumb in breadcrumbs %}
				  {% if loop.last %}
				    <li class="breadcrumb-item active" style="color: var(--bs-heading-color) !important;">{{ breadcrumb.text }}</li>
				  {% else %}
				    <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}" style="color: #64748b !important; text-decoration: none;">{{ breadcrumb.text }}</a></li>
				  {% endif %}
				{% endfor %}
			</ul>
		</div>
	</div>

	<div class="container-fluid">
		{% if success %}
		<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
			<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
		</div>
		{% endif %}
		{% if error %}
		<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error }}
			<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
		</div>
		{% endif %}

		<div class="card">
			<div class="card-header d-flex justify-content-between align-items-center">
				<span style="color: var(--bs-heading-color) !important; font-weight: 600; font-family: 'Outfit', 'Inter', sans-serif; font-size: 15px; display: inline-flex; align-items: center;"><i class="fa-solid fa-list" style="margin-right: 8px;"></i> Batch Display</span>
				<div class="d-flex gap-2 align-items-center">
					<button type="button" onclick="location.href='{{ export }}'" data-toggle="tooltip" title="Export" class="btn btn-custom-export">Export <i class="fa-solid fa-download"></i></button>
					<button type="button" data-bs-toggle="modal" data-bs-target="#modal-create-batch" data-toggle="tooltip" title="Add" class="btn btn-primary btn-custom-add"><i class="fa-solid fa-plus"></i> Add Batch</button>
					<button type="button" data-toggle="tooltip" title="Delete" class="btn btn-danger btn-custom-delete" onclick="if ($('input[name*=\'selected\']:checked').length == 0) { alert('Please select at least one item to delete.'); return false; } if (confirm('Are you sure?')) { $('#form-batch').submit(); }"><i class="fa-solid fa-trash-can text-white"></i> Delete</button>
				</div>
			</div>
      <div class="card-body panel-body">
        <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-batch">
          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <td style="width: 1px; text-align: center;">
                    <input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" />
                  </td>
                  <td class="text-center font-bold">SRNO</td>
                  <td class="text-center font-bold">
                    {% if sort == 'batch_no' %}
                    <a href="{{ sort_batch_no }}" class="{{ order|lower }}">Batch No</a>
                    {% else %}
                    <a href="{{ sort_batch_no }}">Batch No</a>
                    {% endif %}
                  </td>
                  <td class="text-center font-bold">
                    {% if sort == 'received_products' %}
                    <a href="{{ sort_received_products }}" class="{{ order|lower }}">Received Products</a>
                    {% else %}
                    <a href="{{ sort_received_products }}">Received Products</a>
                    {% endif %}
                  </td>
                  <td class="text-center font-bold">
                    {% if sort == 'created_products' %}
                    <a href="{{ sort_created_products }}" class="{{ order|lower }}">Created Products</a>
                    {% else %}
                    <a href="{{ sort_created_products }}">Created Products</a>
                    {% endif %}
                  </td>
                  <td class="text-center font-bold">
                    {% if sort == 'received_q' %}
                    <a href="{{ sort_received_q }}" class="{{ order|lower }}">Received Quantity</a>
                    {% else %}
                    <a href="{{ sort_received_q }}">Received Quantity</a>
                    {% endif %}
                  </td>
                  <td class="text-center font-bold">
                    {% if sort == 'available_q' %}
                    <a href="{{ sort_available_q }}" class="{{ order|lower }}">Available Quantity</a>
                    {% else %}
                    <a href="{{ sort_available_q }}">Available Quantity</a>
                    {% endif %}
                  </td>
                  <td class="text-center font-bold">
                    {% if sort == 'sold_q' %}
                    <a href="{{ sort_sold_q }}" class="{{ order|lower }}">Sold Quantity</a>
                    {% else %}
                    <a href="{{ sort_sold_q }}">Sold Quantity</a>
                    {% endif %}
                  </td>
                  <td class="text-center font-bold">
                    {% if sort == 'created_date' %}
                    <a href="{{ sort_created_date }}" class="{{ order|lower }}">Creation Date</a>
                    {% else %}
                    <a href="{{ sort_created_date }}">Creation Date</a>
                    {% endif %}
                  </td>
                  <td class="text-center font-bold">Action</td>
                </tr>
              </thead>
              <tbody>
                {% if pos_batches %}
                {% set srno = 1 %}
                {% for batch in pos_batches %}
                <tr {% if batch.batch_no == selected_batch %}class="active-batch"{% endif %}>
                  <td class="text-center">
                    <input type="checkbox" name="selected[]" value="{{ batch.id }}" />
                  </td>
                  <td class="text-center">{{ srno }}</td>
                  <td class="text-center">
                    <a href="{{ batch.select_link }}" class="batch-link" style="color: #3b82f6; font-weight: bold; text-decoration: none;">{{ batch.batch_no }}</a>
                  </td>
                  <td class="text-center">{{ batch.received_products }}</td>
                  <td class="text-center">{{ batch.created_products }}</td>
                  <td class="text-center">{{ batch.received_q }}</td>
                  <td class="text-center">{{ batch.available_q }}</td>
                  <td class="text-center">{{ batch.sold_q }}</td>
                  <td class="text-center">{{ batch.creation_date }}</td>
                  <td class="text-center">
                    <button type="button" onclick="editBatch('{{ batch.id }}', '{{ batch.batch_no }}', '{{ batch.received_q }}', '{{ batch.received_products }}', '{{ batch.creation_date_raw }}')" data-toggle="tooltip" title="Edit Batch" class="btn btn-primary btn-sm" style="background: #465fff; border: 1px solid #465fff; color: #fff; padding: 6px 12px; border-radius: 4px; font-weight: 600;">
                      <i class="fa-solid fa-pencil" style="margin-right: 4px;"></i>Edit
                    </button>
                  </td>
                </tr>
                {% set srno = srno + 1 %}
                {% endfor %}
                {% else %}
                <tr>
                  <td class="text-center" colspan="10">No results!</td>
                </tr>
                {% endif %}
              </tbody>
            </table>
          </div>
        </form>
        
        <div class="row" style="margin-top: 15px; padding: 0 15px;">
          <div class="col-sm-6 text-start">{{ results }}</div>
          <div class="col-sm-6 text-end">{{ pagination }}</div>
        </div>
      </div>
    </div>
    
    <div id="product-create-container">
    {% if selected_batch is not empty %}
    <div style="margin-top: 30px;">
        <div class="card panel panel-default" style="margin-top: 20px;">
  <div class="card-header panel-heading d-flex justify-content-between align-items-center" style="background: #fff;">
    <h3 class="card-title panel-title m-0" style="font-size: 16px; font-weight: 600;"><i class="fa fa-barcode"></i> Product Create Page - Batch: {{ selected_batch }}</h3>
    <div style="font-size: 12px; font-weight: 600; color: #64748b; display: inline-flex; align-items: center; gap: 8px;">
      SETTINGS: WP-Add % <input type="text" id="setting-wp-add" value="{{ wp_add_pct ? wp_add_pct : 20 }}" readonly style="width: 40px; text-align: center; border: 1px solid #e2e8f0; border-radius: 4px; padding: 2px; background: #f8fafc; cursor: not-allowed; color: #64748b;"> 
      RP-Add % <input type="text" id="setting-rp-add" value="{{ rp_add_pct ? rp_add_pct : 20 }}" readonly style="width: 40px; text-align: center; border: 1px solid #e2e8f0; border-radius: 4px; padding: 2px; margin-right: 10px; background: #f8fafc; cursor: not-allowed; color: #64748b;">
      <button type="button" data-toggle="tooltip" title="Delete" class="btn btn-danger btn-custom-delete" onclick="deleteSelectedProducts()"><i class="fa-solid fa-trash-can text-white"></i> Delete</button>
    </div>
  </div>
  
    <form action="{{ action }}" method="post" id="form-product" onsubmit="return false;"></form>
    <table class="table table-bordered table-hover" style="margin-bottom: 0; background: #fff;">
      <thead style="background: #f8f9fa;">
        <tr>
          <td style="width: 1px; text-align: center;"><input type="checkbox" onclick="$('input[name*=\'selected_products\']').prop('checked', this.checked);" /></td>
          <td class="text-center font-bold">SRNO</td>
          <td class="text-center font-bold">Batch No</td>
          <td class="text-center font-bold">Box ID / Product Name</td>
          <td class="text-center font-bold">Image</td>
          <td class="text-center font-bold">Type / Received Price</td>
          <td class="text-center font-bold">WP / SWP</td>
          <td class="text-center font-bold">RP / SRP</td>
          <td class="text-center font-bold">Quantity</td>
          <td class="text-center font-bold" style="width: 200px; min-width: 200px;">Barcode</td>
          <td class="text-center font-bold">Rack</td>
          <td class="text-center font-bold">Creation Date</td>
          <td class="text-center font-bold">Action</td>
        </tr>
      </thead>
      <tbody>
        <!-- Add Form Row -->
        <tr style="background: #fff;">
            <td class="text-center" style="vertical-align: middle;"></td>
            <td class="text-center" style="vertical-align: middle;">+</td>
            <td class="text-center" style="vertical-align: middle;">{{ selected_batch }}</td>
            <td style="vertical-align: middle;">
              <input type="text" name="box_id" form="form-product" placeholder="Box ID" class="form-control form-control-sm mb-1" style="text-align: center; border-radius: 4px; border: 1px solid #3b82f6; color: #3b82f6;">
              <input type="text" name="name" form="form-product" placeholder="Product Name" class="form-control form-control-sm" style="text-align: center; border-radius: 4px; border: 1px solid #3b82f6; color: #3b82f6;" required>
            </td>
            <td class="text-center" style="vertical-align: middle;">
              <div style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
                <button type="button" id="button-upload-image" class="btn" style="background: #f8fafc; color: #94a3b8; border-radius: 8px; width: 44px; height: 44px; padding: 0; display: flex; align-items: center; justify-content: center; border: 1px dashed #cbd5e1; margin-bottom: 4px;">
                  <i class="fa fa-upload" style="font-size: 18px;"></i>
                </button>
                <div id="text-upload-image" onclick="$('#button-upload-image').click();" style="font-size: 11px; font-weight: 600; color: #64748b; line-height: 1.2; cursor: pointer;">Upload<br>Image</div>
                <input type="hidden" name="image" value="" id="input-image" form="form-product">
              </div>
            </td>
            <td style="vertical-align: middle;">
              <select name="type" form="form-product" class="form-control form-control-sm mb-1" style="text-align: center; border-radius: 4px; border: 1px solid #3b82f6; color: #3b82f6;">
                <option value="Global">Global</option>
                <option value="Local">Local</option>
              </select>
              <input type="text" name="received_price" id="input-received-price" form="form-product" placeholder="Rec Price" class="form-control form-control-sm" style="text-align: center; border-radius: 4px; border: 1px solid #3b82f6; color: #3b82f6;">
            </td>
            <td style="vertical-align: middle;">
              <input type="text" name="wp" form="form-product" placeholder="0.00" class="form-control form-control-sm mb-1" style="text-align: center; border-radius: 4px; border: 1px solid #3b82f6; color: #3b82f6;">
              <input type="text" name="swp" form="form-product" placeholder="SWP" class="form-control form-control-sm" style="text-align: center; border-radius: 4px; border: 1px solid #3b82f6; color: #3b82f6;">
            </td>
            <td style="vertical-align: middle;">
              <input type="text" name="rp" form="form-product" placeholder="0.00" class="form-control form-control-sm mb-1" style="text-align: center; border-radius: 4px; border: 1px solid #3b82f6; color: #3b82f6;">
              <input type="text" name="srp" form="form-product" placeholder="SRP" class="form-control form-control-sm" style="text-align: center; border-radius: 4px; border: 1px solid #3b82f6; color: #3b82f6;">
            </td>
            <td style="vertical-align: middle;">
              <input type="number" step="0.01" name="quantity" form="form-product" placeholder="Qty" class="form-control form-control-sm" style="text-align: center; border-radius: 4px; border: 1px solid #3b82f6; color: #3b82f6;" required>
            </td>
            <td style="vertical-align: middle; width: 200px; min-width: 200px;">
              <select name="barcode_type" form="form-product" class="form-control form-control-sm mb-1" style="text-align: center; border-radius: 4px; border: 1px solid #3b82f6; color: #3b82f6;">
                <option value="Unit">Unit</option>
                <option value="Box">Box</option>
              </select>
              <div class="input-group input-group-sm">
                <input type="text" name="barcode" id="input-barcode" form="form-product" placeholder="Barcode" class="form-control" style="border-radius: 4px 0 0 4px; border: 1px solid #3b82f6; color: #3b82f6;" required>
                <button type="button" class="btn btn-primary" onclick="generateBarcode()" style="background: #3b82f6; border-color: #3b82f6;"><i class="fa fa-refresh"></i> Gen</button>
              </div>
            </td>
            <td style="vertical-align: middle;">
              <input type="number" name="rack" form="form-product" placeholder="Rack" class="form-control form-control-sm" style="text-align: center; border-radius: 4px; border: 1px solid #3b82f6; color: #3b82f6;">
            </td>
            <td class="text-center" style="vertical-align: middle; font-size: 12px; color: #64748b;">Today</td>
            <td class="text-center" style="vertical-align: middle;">
              <button type="submit" form="form-product" class="btn btn-primary btn-sm" style="background-color: #465fff !important; border-color: #465fff !important; color: #ffffff !important; border-radius: 4px; font-weight: 600; padding: 6px 12px;"><i class="fa-solid fa-floppy-disk" style="margin-right: 4px;"></i> Save</button>
            </td>
        </tr>
        
        <!-- Saved Products List -->
        {% if batch_products %}
          {% set p_srno = 1 %}
          {% for product in batch_products %}
            <tr>
              <td class="text-center" style="vertical-align: middle;"><input type="checkbox" name="selected_products[]" value="{{ product.product_id }}" /></td>
              <td class="text-center" style="vertical-align: middle;">{{ p_srno }}</td>
              <td class="text-center" style="vertical-align: middle;">{{ selected_batch }}</td>
              <td class="text-center" style="vertical-align: middle;">
                <div style="font-size: 12px; margin-bottom: 4px;">{{ product.box_id }}</div>
                <div style="font-size: 13px; font-weight: 600;">{{ product.name }}</div>
              </td>
              <td class="text-center" style="vertical-align: middle;">
                <div style="width: 40px; height: 40px; background: transparent; border: 1px solid #e2e8f0; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; overflow: hidden;">
                  {% if product.image %}
                  <img src="../image/{{ product.image }}" style="width: 100%; height: 100%; object-fit: cover;" alt="Product Image" />
                  {% else %}
                  <span style="color: #64748b; font-size: 18px;"><i class="fa fa-image"></i></span>
                  {% endif %}
                </div>
              </td>
              <td class="text-center" style="vertical-align: middle;">
                <div style="font-size: 12px; margin-bottom: 4px;">{{ product.price_type|capitalize }}</div>
                <div style="font-size: 12px; font-weight: 600; color: #64748b;">₹{{ product.received_price }}</div>
              </td>
              <td class="text-center" style="vertical-align: middle;">
                <div style="font-size: 13px; font-weight: 600; margin-bottom: 4px;">₹{{ product.wp }}</div>
                <div style="font-size: 12px; color: #64748b;">S: ₹{{ product.swp }}</div>
              </td>
              <td class="text-center" style="vertical-align: middle;">
                <div style="font-size: 13px; font-weight: 600; margin-bottom: 4px;">₹{{ product.rp }}</div>
                <div style="font-size: 12px; color: #64748b;">S: ₹{{ product.srp }}</div>
              </td>
              <td class="text-center" style="vertical-align: middle; font-weight: 600;">{{ product.quantity }}</td>
              <td class="text-center" style="vertical-align: middle;">
                <div style="font-size: 10px; font-weight: bold;">{{ product.barcode_type|upper }}</div>
                <svg class="barcode-svg"
                     jsbarcode-format="code128"
                     jsbarcode-value="{{ product.barcode }}"
                     jsbarcode-height="20"
                     jsbarcode-width="1"
                     jsbarcode-displayvalue="false"
                     jsbarcode-margin="0"
                     style="max-width: 100px;">
                </svg>
                <div style="font-size: 11px; font-weight: bold;">{{ product.barcode }}</div>
              </td>
              <td class="text-center" style="vertical-align: middle;">{{ product.rack_code }}</td>
              <td class="text-center" style="vertical-align: middle; font-size: 12px;">{{ product.date_added }}</td>
              <td class="text-center" style="vertical-align: middle;">
                <div class="d-flex justify-content-center" style="gap: 5px;">
                  <button type="button"
                          class="ptsbarcodeselect btn-success btn btn-sm"
                          data-maxqty="{{ product.max_quantity }}"
                          data-price="{{ product.rp }}"
                          data-wholesale="{{ product.wp }}"
                          data-rtag="{{ product.r_tag }}"
                          data-wtag="{{ product.w_tag }}"
                          data-rackcode="{{ product.rack_code }}"
                          data-boxid="{{ product.box_id }}"
                          data-productid="{{ product.product_id }}"
                          data-barcode="{{ product.barcode }}"
                          data-name="{{ product.name|escape }}"
                          data-bs-toggle="modal"
                          data-bs-target="#mymodel"
                          style="background: #465fff; border: none; color: #fff; border-radius: 4px; padding: 6px; font-size: 11px; display: inline-flex; flex-direction: column; align-items: center; justify-content: center; width: 45px; height: 45px;">
                    <i class="fa-solid fa-print" style="font-size: 14px; margin-bottom: 3px;"></i>Print
                  </button>
                  <button type="button" class="btn btn-warning btn-sm" 
                    data-product-id="{{ product.product_id }}"
                    data-box-id="{{ product.box_id }}"
                    data-name="{{ product.name|escape }}"
                    data-received-price="{{ product.received_price }}"
                    data-price-type="{{ product.price_type }}"
                    data-wp="{{ product.wp }}"
                    data-swp="{{ product.swp }}"
                    data-rp="{{ product.rp }}"
                    data-srp="{{ product.srp }}"
                    data-quantity="{{ product.quantity }}"
                    data-barcode="{{ product.barcode }}"
                    data-barcode-type="{{ product.barcode_type }}"
                    data-rack="{{ product.rack_code }}"
                    data-image="{{ product.image }}"
                    data-created-date="{{ product.date_added_raw }}"
                    onclick="editBatchProduct(this)" 
                    style="background: #465fff; border: none; color: #fff; border-radius: 4px; padding: 6px; font-size: 11px; display: inline-flex; flex-direction: column; align-items: center; justify-content: center; width: 45px; height: 45px;"><i class="fa-solid fa-pencil" style="font-size: 14px; margin-bottom: 3px;"></i>Edit</button>
                  <button type="button" class="btn btn-danger btn-sm" onclick="deleteBatchProduct('{{ product.product_id }}')" style="background: #ef4444; border: none; border-radius: 4px; padding: 6px; font-size: 11px; display: inline-flex; flex-direction: column; align-items: center; justify-content: center; width: 45px; height: 45px;"><i class="fa-solid fa-trash-can" style="font-size: 14px; margin-bottom: 3px;"></i>Delete</button>
                </div>
              </td>
            </tr>
            {% set p_srno = p_srno + 1 %}
          {% endfor %}
        {% endif %}
      </tbody>
    </table>
  </div>
</div>
    {% endif %}
    </div>

{# Print Barcode Modal - same as Products page #}
<div class="modal" id="mymodel">
  <div class="modal-dialog">
    <div class="modal-content masspopup">
      <div class="modal-header">
        <h6 class="modal-title" style="color:black;">Enter the number of barcode slips</h6>
        <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form method="post" target="_blank" action="{{ action_printbarcode }}">
          <div class="form-group">
            <label class="masspopuplabel" style="color:black;">Enter Quantity</label>
            <input type="hidden" id="printbarcode" name="printbarcode">
            <input type="hidden" id="printbarcodename" name="printbarcodename">
            <input type="hidden" id="printbarcodeprice" name="printbarcodeprice">
            <input type="hidden" id="printsku" name="printsku">
            <input type="hidden" id="printmaxqty" name="printmaxqty">
            <input type="hidden" id="print_r_tag" name="print_r_tag">
            <input type="hidden" id="print_w_tag" name="print_w_tag">
            <input type="hidden" id="print_price" name="print_price">
            <input type="hidden" id="print_product_id" name="print_product_id">
            <input type="hidden" id="print_rack_code" name="print_rack_code">
            <input type="hidden" id="print_box_id" name="print_box_id">
            <input type="hidden" id="print_wholesale" name="print_wholesale">
            <input type="number" class="form-control massinputpopup" style="color:black;" name="qty" required>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="background-color: #ef4444 !important; border-color: #ef4444 !important; color: #ffffff !important; border-radius: 20px !important; padding: 6px 24px !important; font-weight: 500 !important; font-size: 14px !important;">Close</button>
            <input type="submit" class="btn btn-success" value="Print" style="background-color: #465fff !important; border-color: #465fff !important; color: #ffffff !important; border-radius: 20px !important; padding: 6px 24px !important; font-weight: 500 !important; font-size: 14px !important;">
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
$(document).on('click', '.ptsbarcodeselect', function () {
    var btn = $(this);

    var barcodeprint     = btn.data('barcode');
    var barcodeprintname = btn.data('name');
    var price            = btn.data('price');
    var wholesale        = btn.data('wholesale');
    var r_tag            = btn.data('rtag');
    var w_tag            = btn.data('wtag');
    var product_id       = btn.data('productid');
    var rack_code        = btn.data('rackcode');
    var maxqty           = btn.data('maxqty');
    var box_id           = btn.data('boxid');

    $('#printbarcode').val(barcodeprint);
    $('#printbarcodename').val(barcodeprintname);
    $('#printbarcodeprice').val(price);
    $('#printsku').val(barcodeprint);
    $('#printmaxqty').val(maxqty);
    $('#print_price').val(price);
    $('#print_wholesale').val(wholesale);
    $('#print_r_tag').val(r_tag);
    $('#print_w_tag').val(w_tag);
    $('#print_product_id').val(product_id);
    $('#print_rack_code').val(rack_code);
    $('#print_box_id').val(box_id);
});

$('#mymodel').on('show.bs.modal', function () {
    $(this).find('input[name="qty"]').val('');
});
</script>

<script>
$(document).ready(function() {
    // Intercept clicks on the batch links to load the bottom table via AJAX
    $(document).on('click', '.batch-link', function(e) {
        e.preventDefault();
        var url = $(this).attr('href');
        
        // Add a loading indicator or dim the container
        $('#product-create-container').css('opacity', '0.5');
        
        // Highlight the selected row visually
        $('#form-batch tbody tr').removeClass('active-batch');
        $(this).closest('tr').addClass('active-batch');
        $('.batch-link').removeClass('active-batch-link');
        $(this).addClass('active-batch-link');
        
        $.ajax({
            url: url,
            type: 'get',
            dataType: 'html',
            cache: false,
            success: function(html) {
                // Extract the #product-create-container content from the returned HTML
                var newContent = $(html).find('#product-create-container').html();
                $('#product-create-container').html(newContent).css('opacity', '1');
                
                // Initialize barcodes
                if (typeof JsBarcode !== 'undefined') {
                    JsBarcode(".barcode-svg").init();
                }
                
                // Deliberately NOT using pushState here.
                // This ensures that if the user hits refresh (F5), they go back to the clean URL without a batch_no!
            },
            error: function() {
                // Fallback to standard navigation if AJAX fails
                window.location = url;
            }
        });
    });
});
</script>

