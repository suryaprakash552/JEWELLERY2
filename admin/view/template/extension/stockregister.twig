function generateEditBarcode() {
    if ($('#edit-barcode').val().trim() !== '') {
        return; // Already generated
    }
    var type = $('#edit-barcode-type').val().toLowerCase();
    $.ajax({
        url: 'index.php?route=catalog/product.generateBarcode&user_token={{ user_token }}&type=' + type,
        dataType: 'json',
        success: function(json) {
            if (json['barcode']) {
                $('#edit-barcode').val(json['barcode']);
            }
        },
        error: function() {
            alert('Error generating barcode!');
        }
    });
}

function generateBarcode() {
    if ($('#input-barcode').val().trim() !== '') {
        return; // Already generated
    }
    var type = $('select[name="barcode_type"]').val() ? $('select[name="barcode_type"]').val().toLowerCase() : 'unit';
    $.ajax({
        url: 'index.php?route=catalog/product.generateBarcode&user_token={{ user_token }}&type=' + type,
        dataType: 'json',
        success: function(json) {
            if (json['barcode']) {
                $('#input-barcode').val(json['barcode']);
            }
        },
        error: function() {
            alert('Error generating barcode!');
        }
    });
}

function printBarcode(barcode, name) {
    if (!barcode) return;
    
    // Create a temporary SVG element
    var svgNode = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    document.body.appendChild(svgNode);
    
    // Generate barcode using local JsBarcode
    if (typeof JsBarcode !== 'undefined') {
        JsBarcode(svgNode, barcode, {
            format: "code128",
            height: 40,
            displayValue: true,
            fontSize: 16,
            margin: 10
        });
    }
    
    var svgHtml = svgNode.outerHTML;
    document.body.removeChild(svgNode);

    var printWindow = window.open('', '_blank', 'width=400,height=400');
    printWindow.document.write('<html><head><title>Print Barcode</title></head><body style="text-align:center;font-family:Arial;padding:20px;">');
    printWindow.document.write('<h4 style="margin-bottom:10px;">' + name + '</h4>');
    printWindow.document.write('<div>' + svgHtml + '</div>');
    printWindow.document.write('<script>window.onload = function() { window.print(); window.close(); }<\/script>');
    printWindow.document.write('</body></html>');
    printWindow.document.close();
}

$(document).ready(function() {
    // Direct Upload Image functionality to system files
    $(document).on('click', '#button-upload-image, #button-edit-image', function() {
        var node = this;
        var isModal = $(this).attr('id') === 'button-edit-image';
        
        $('#form-upload').remove();
        $('body').prepend('<form enctype="multipart/form-data" id="form-upload" style="display: none;"><input type="file" name="file" accept="image/*" /></form>');
        $('#form-upload input[name=\'file\']').trigger('click');
        if (typeof timer != 'undefined') {
            clearInterval(timer);
        }
        timer = setInterval(function() {
            if ($('#form-upload input[name=\'file\']').val() != '') {
                clearInterval(timer);
                $.ajax({
                    url: 'index.php?route=extension/stockregister.uploadImage&user_token={{ user_token }}',
                    type: 'post',
                    dataType: 'json',
                    data: new FormData($('#form-upload')[0]),
                    cache: false,
                    contentType: false,
                    processData: false,
                    beforeSend: function() {
                        $(node).find('i').replaceWith('<i class="fa fa-circle-o-notch fa-spin" style="font-size: ' + (isModal ? '24px' : '18px') + ';"></i>');
                    },
                    complete: function() {
                        $(node).find('i').replaceWith('<i class="fa ' + (isModal ? 'fa-cloud-upload' : 'fa-upload') + '" style="font-size: ' + (isModal ? '24px' : '18px') + ';"></i>');
                    },
                    success: function(json) {
                        if (json['error']) {
                            alert(json['error']);
                        }
                        if (json['success']) {
                            if (isModal) {
                                $('#input-edit-image').val(json['image_path']);
                                $('#text-edit-image').html('Change Image');
                            } else {
                                $('#input-image').val(json['image_path']);
                                $('#text-upload-image').html('Change<br>Image');
                            }
                            
                            // Display the uploaded image inside the button
                            var imageUrl = '../image/' + json['image_path'];
                            $(node).empty().append('<img src="' + imageUrl + '" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;" alt="Product Image" />');
                            
                            $(node).css('background', 'transparent'); 
                            $(node).css('padding', '0');
                        }
                    },
                    error: function(xhr, ajaxOptions, thrownError) {
                        alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                    }
                });
            }
        }, 500);
    });

    // WP/RP Auto Calculation
    $(document).on('input', '#input-received-price, #edit-received-price', function() {
        var isModal = $(this).attr('id') === 'edit-received-price';
        var recPrice = parseFloat($(this).val()) || 0;
        
        var wpAddPercent = parseFloat($('#setting-wp-add').val()) || 0;
        var rpAddPercent = parseFloat($('#setting-rp-add').val()) || 0;
        
        var priceType = isModal ? $('#edit-price-type').val() : $('select[name="type"]').val();
        
        if (priceType && priceType.toLowerCase() === 'local') {
            return; // Do not auto-calculate for Local
        }
        
        if (recPrice > 0) {
            var wp = recPrice + (recPrice * (wpAddPercent / 100));
            var rp = recPrice + (recPrice * (rpAddPercent / 100));
            
            if (isModal) {
                $('#edit-wp').val(wp.toFixed(2));
                $('#edit-rp').val(rp.toFixed(2));
            } else {
                $('input[name="wp"]').not('#edit-wp').val(wp.toFixed(2));
                $('input[name="rp"]').not('#edit-rp').val(rp.toFixed(2));
            }
        }
    });
    
    // Trigger calculation when changing price type back to Global, or clear when changing to Local
    $(document).on('change', '#edit-price-type, select[name="type"]', function() {
        var isModal = $(this).attr('id') === 'edit-price-type';
        var priceType = $(this).val();
        
        if (priceType && priceType.toLowerCase() === 'global') {
            var targetInput = isModal ? $('#edit-received-price') : $('#input-received-price');
            targetInput.trigger('input');
        } else if (priceType && priceType.toLowerCase() === 'local') {
            if (isModal) {
                $('#edit-wp').val('');
                $('#edit-rp').val('');
            } else {
                $('input[name="wp"]').not('#edit-wp').val('');
                $('input[name="rp"]').not('#edit-rp').val('');
            }
        }
    });
});
</script>

