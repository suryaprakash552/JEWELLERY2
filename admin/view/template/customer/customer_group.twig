{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end"><a href="{{ add }}" data-bs-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary btn-custom-add"><i class="fa-solid fa-plus"></i> Add</a>
        <button type="submit" form="form-customer-group" formaction="{{ delete }}" data-bs-toggle="tooltip" title="{{ button_delete }}" onclick="if ($('input[name*=\'selected\']:checked').length == 0) { alert('Please select at least one item to delete.'); return false; } return confirm('{{ text_confirm }}');" class="btn btn-danger btn-custom-delete"><i class="fa-solid fa-trash-can text-white"></i> Delete</button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-list"></i> {{ text_list }}</div>
      <div id="customer-group" class="card-body">{{ list }}</div>
    </div>
  </div>
</div>
{{ footer }}
<script type="text/javascript"><!--
$('#customer-group').on('click', 'thead a, .pagination a', function(e) {
    e.preventDefault();

    $('#customer-group').load(this.href);
});
//--></script>