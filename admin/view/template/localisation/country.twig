{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="button" data-bs-toggle="modal" data-bs-target="#modal-filter-country" class="btn btn-custom-filter-white"><i class="fa-solid fa-sliders"></i> Filter</button>
        <a href="{{ add }}" data-bs-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary btn-custom-add"><i class="fa-solid fa-plus"></i> Add</a>
        <button type="submit" form="form-country" formaction="{{ delete }}" data-bs-toggle="tooltip" title="{{ button_delete }}" onclick="if ($('input[name*=\'selected\']:checked').length == 0) { alert('Please select at least one item to delete.'); return false; } return confirm('{{ text_confirm }}');" class="btn btn-danger btn-custom-delete"><i class="fa-solid fa-trash-can text-white"></i> Delete</button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card">
          <div class="card-header"><i class="fa-solid fa-list"></i> {{ text_list }}</div>
          <div id="country" class="card-body">{{ list }}</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="modal-filter-country" tabindex="-1" aria-labelledby="modal-filter-country-label" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modal-filter-country-label"><i class="fa-solid fa-filter"></i> {{ text_filter }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="form-filter">
          <div class="mb-3">
            <label class="form-label">{{ entry_name }}</label>
            <input type="text" name="filter_name" value="{{ filter_name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control"/>
          </div>
          <div class="mb-3">
            <label class="form-label">{{ entry_iso_code_2 }}</label>
            <input type="text" name="filter_iso_code_2" value="{{ filter_iso_code_2 }}" placeholder="{{ entry_iso_code_2 }}" id="input-iso-code-2" class="form-control"/>
          </div>
          <div class="mb-3">
            <label class="form-label">{{ entry_iso_code_3 }}</label>
            <input type="text" name="filter_iso_code_3" value="{{ filter_iso_code_3 }}" placeholder="{{ entry_iso_code_3 }}" id="input-iso-code-3" class="form-control"/>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" id="button-reset" class="btn btn-outline-secondary"><i class="fa-solid fa-filter-circle-xmark"></i> Reset</button>
        <button type="button" id="button-filter" data-bs-dismiss="modal" class="btn btn-custom-filter-white"><i class="fa-solid fa-sliders"></i> {{ button_filter }}</button>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript"><!--
$('#country').on('click', 'thead a, .pagination a', function(e) {
    e.preventDefault();

    $('#country').load(this.href);
});

$('#button-filter').on('click', function() {
    var url = '';

    var filter_name = $('#input-name').val();

    if (filter_name) {
        url += '&filter_name=' + encodeURIComponent(filter_name);
    }

    var filter_iso_code_2 = $('#input-iso-code-2').val();

    if (filter_iso_code_2) {
        url += '&filter_iso_code_2=' + encodeURIComponent(filter_iso_code_2);
    }

    var filter_iso_code_3 = $('#input-iso-code-3').val();

    if (filter_iso_code_3) {
        url += '&filter_iso_code_3=' + encodeURIComponent(filter_iso_code_3);
    }

    window.history.pushState({}, null, 'index.php?route=localisation/country&user_token={{ user_token }}' + url);

    $('#country').load('index.php?route=localisation/country.list&user_token={{ user_token }}' + url);
});

$('#button-reset').on('click', function () {
    $('#form-filter')[0].reset();
    $('#modal-filter-country').modal('hide');
    window.history.pushState({}, null, 'index.php?route=localisation/country&user_token={{ user_token }}');
    $('#country').load('index.php?route=localisation/country.list&user_token={{ user_token }}');
});
//--></script>
<style>
.btn-custom-filter-white {
    background-color: #ffffff !important;
    border: 1px solid #dee4ee !important;
    color: #1c2434 !important;
    border-radius: 6px !important;
    height: 38px !important;
    padding: 0 16px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-sizing: border-box !important;
    vertical-align: middle !important;
    line-height: normal !important;
    font-weight: 500 !important;
    text-decoration: none !important;
    transition: all 0.2s ease-in-out;
}
.btn-custom-filter-white:hover {
    background-color: #f8fafc !important;
    border-color: #cbd5e1 !important;
    color: #1c2434 !important;
}
.btn-custom-filter-white i,
.btn-custom-filter-white svg {
    margin-right: 8px !important;
    margin-left: 0 !important;
    color: #1c2434 !important;
}
.btn-custom-filter-white:hover i,
.btn-custom-filter-white:hover svg {
    color: #1c2434 !important;
}
</style>
{{ footer }}
