<form id="form-order" method="post" data-oc-load="{{ action }}" data-oc-target="#order">
  <div class="table-responsive">
    <table class="table table-bordered table-hover">
      <thead>
        <tr>
          <th class="text-center" style="width: 1px;"><input type="checkbox" onclick="$('input[name*=\'selected\']').trigger('click');" class="form-check-input"/></th>
          <th class="text-center"><a href="{{ sort_order }}"{% if sort == 'o.order_id' %} class="{{ order|lower }}"{% endif %}>{{ column_order_id }}</a></th>
          <th class="text-center"><a href="{{ sort_store_name }}"{% if sort == 'o.store_name' %} class="{{ order|lower }}"{% endif %}>{{ column_store }}</a></th>
          <th class="text-center"><a href="{{ sort_telephone }}"{% if sort == 'o.telephone' %} class="{{ order|lower }}"{% endif %}>Telephone</a></th>
          <th class="text-center"><a href="{{ sort_customer }}"{% if sort == 'customer' %} class="{{ order|lower }}"{% endif %}>{{ column_customer }}</a></th>
          <th class="text-center">Items</th>
          <th class="text-center">Quantity</th>
          <th class="text-center"><a href="{{ sort_total }}"{% if sort == 'o.total' %} class="{{ order|lower }}"{% endif %}>{{ column_total }}</a></th>
          <th class="text-center d-none d-lg-table-cell"><a href="{{ sort_date_added }}"{% if sort == 'o.date_added' %} class="{{ order|lower }}"{% endif %}>{{ column_date_added }}</a></th>
          <th class="text-center d-none d-xl-table-cell"><a href="{{ sort_date_modified }}"{% if sort == 'o.date_modified' %} class="{{ order|lower }}"{% endif %}>{{ column_date_modified }}</a></th>
          <th class="text-center"><a href="{{ sort_status }}"{% if sort == 'order_status' %} class="{{ order|lower }}"{% endif %}>{{ column_status }}</a></th>
          <th class="text-center">Delivery Boy</th>
          <th class="text-center">{{ column_action }}</th>
        </tr>
      </thead>
      <tbody>
        {% if orders %}
          {% for order in orders %}
            <tr>
              <td class="text-center"><input type="checkbox" name="selected[]" value="{{ order.order_id }}" class="form-check-input"/><input type="hidden" name="shipping_method[]" value="{% if order.shipping_method %}1{% else %}0{% endif %}"/></td>
              <td class="text-center">{{ order.order_id }}</td>
              <td class="text-center">{{ order.store_name }}</td>
              <td class="text-center">{{ order.telephone }}</td>
              <td class="text-center">{{ order.customer }}</td>
              <td class="text-center">{{ order.items_count }}</td>
              <td class="text-center">{{ order.total_quantity }}</td>
              <td class="text-center">{{ order.total }}</td>
              <td class="text-center d-none d-lg-table-cell">{{ order.date_added }}</td>
              <td class="text-center d-none d-xl-table-cell">{{ order.date_modified }}</td>
              <td class="text-center">{{ order.order_status }}</td>
              <td class="text-center">{{ order.delivery_boy }}</td>
              <td class="text-center"><a href="{{ order.view }}" data-bs-toggle="tooltip" title="{{ button_view }}" class="btn btn-custom-edit"><i class="fa-solid fa-eye"></i>View</a></td>
            </tr>
          {% endfor %}
        {% else %}
          <tr>
            <td class="text-center" colspan="13">{{ text_no_results }}</td>
          </tr>
        {% endif %}
      </tbody>
    </table>
  </div>
  <div class="row">
    <div class="col-sm-6 text-start">{{ results }}</div>
    <div class="col-sm-6 text-end">{{ pagination }}</div>
  </div>
</form>