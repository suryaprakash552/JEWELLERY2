{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="button" data-bs-toggle="modal" data-bs-target="#modalFilter" class="btn btn-custom-filter-white"><i class="fa-solid fa-sliders"></i> Filter</button>

        <a href="{{ add }}" data-bs-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary btn-custom-add"><i class="fa-solid fa-plus"></i> Add</a>
        <button type="submit" data-oc-toggle="ajax" form="form-order" formaction="{{ delete }}"  data-bs-toggle="tooltip" title="{{ button_delete }}" onclick="if ($('input[name*=\'selected\']:checked').length == 0) { alert('Please select at least one item to delete.'); return false; } return confirm('{{ text_confirm }}');" class="btn btn-danger btn-custom-delete"><i class="fa-solid fa-trash-can text-white"></i> Delete</button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card">
          <div class="card-header"><i class="fa-solid fa-list"></i> {{ text_list }}</div>
          <div id="order" class="card-body">{{ list }}</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="modalFilter" tabindex="-1" aria-labelledby="filterModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="filterModalLabel"><i class="fa-solid fa-filter"></i> {{ text_filter }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="form-filter">
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label for="input-order-id" class="form-label">{{ entry_order_id }}</label>
                <input type="text" name="filter_order_id" value="{{ filter_order_id }}" placeholder="{{ entry_order_id }}" id="input-order-id" class="form-control"/>
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">{{ entry_customer }}</label>
                <input type="text" name="filter_customer" value="{{ filter_customer }}" placeholder="{{ entry_customer }}" id="input-customer" data-oc-target="autocomplete-customer" class="form-control" autocomplete="off"/>
                <ul id="autocomplete-customer" class="dropdown-menu"></ul>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label for="input-telephone" class="form-label">Mobile</label>
                <input type="text" name="filter_telephone" value="{{ filter_telephone }}" placeholder="Mobile" id="input-telephone" class="form-control"/>
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label for="input-store" class="form-label">{{ entry_store }}</label>
                <select name="filter_store_id" id="input-store" class="form-select">
                  <option value=""></option>
                  {% for store in stores %}
                    <option value="{{ store.store_id }}"{% if store.store_id == filter_store_id %} selected{% endif %}>{{ store.name }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label for="input-order-status" class="form-label">{{ entry_order_status }}</label>
                <select name="filter_order_status_id" id="input-order-status" class="form-select">
                  <option value=""></option>
                  <option value="0"{% if filter_order_status_id == '0' %} selected{% endif %}>{{ text_missing }}</option>
                  {% for order_status in order_statuses %}
                    <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == filter_order_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label for="input-total" class="form-label">{{ entry_total }}</label>
                <input type="text" name="filter_total" value="{{ filter_total }}" placeholder="{{ entry_total }}" id="input-total" class="form-control"/>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label for="input-date-from" class="form-label">{{ entry_date_from }}</label>
                <input type="date" name="filter_date_from" value="{{ filter_date_from }}" placeholder="{{ entry_date_from }}" id="input-date-from" class="form-control"/>
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label for="input-date-to" class="form-label">{{ entry_date_to }}</label>
                <input type="date" name="filter_date_to" value="{{ filter_date_to }}" placeholder="{{ entry_date_to }}" id="input-date-to" class="form-control"/>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label for="input-date-modified-from" class="form-label">{{ entry_date_modified_from }}</label>
                <input type="date" name="filter_date_modified_from" value="{{ filter_date_modified_from }}" placeholder="{{ entry_date_modified_from }}" id="input-date-modified-from" class="form-control"/>
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label for="input-date-modified-to" class="form-label">{{ entry_date_modified_to }}</label>
                <input type="date" name="filter_date_modified_to" value="{{ filter_date_modified_to }}" placeholder="{{ entry_date_modified_to }}" id="input-date-modified-to" class="form-control"/>
              </div>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" id="button-reset" class="btn btn-outline-secondary"><i class="fa-solid fa-filter-circle-xmark"></i> Reset</button>
        <button type="button" id="button-filter" class="btn btn-custom-filter-white"><i class="fa-solid fa-sliders"></i> {{ button_filter }}</button>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript"><!--
$('#order').on('click', 'thead a, .pagination a', function(e) {
    e.preventDefault();

    $('#order').load(this.href);
});

$('#button-filter').on('click', function() {
    url = '';

    var filter_order_id = $('#input-order-id').val();

    if (filter_order_id) {
        url += '&filter_order_id=' + filter_order_id;
    }

    var filter_customer = $('#input-customer').val();

    if (filter_customer) {
        url += '&filter_customer=' + encodeURIComponent(filter_customer);
    }
    
    var filter_telephone = $('#input-telephone').val();

    if (filter_telephone) {
        url += '&filter_telephone=' + encodeURIComponent(filter_telephone);
    }

    var filter_store_id = $('#input-store').val();

    if (filter_store_id !== '') {
        url += '&filter_store_id=' + filter_store_id;
    }

    var filter_order_status_id = $('#input-order-status').val();

    if (filter_order_status_id !== '') {
        url += '&filter_order_status_id=' + filter_order_status_id;
    }

    var filter_total = $('#input-total').val();

    if (filter_total) {
        url += '&filter_total=' + encodeURIComponent(filter_total);
    }

    var filter_date_from = $('#input-date-from').val();

    if (filter_date_from) {
        url += '&filter_date_from=' + encodeURIComponent(filter_date_from);
    }

    var filter_date_to = $('#input-date-to').val();

    if (filter_date_to) {
        url += '&filter_date_to=' + encodeURIComponent(filter_date_to);
    }

    var filter_date_modified_from = $('#input-date-modified-from').val();

    if (filter_date_modified_from) {
        url += '&filter_date_modified_from=' + encodeURIComponent(filter_date_modified_from);
    }

    var filter_date_modified_to = $('#input-date-modified-to').val();

    if (filter_date_modified_to) {
        url += '&filter_date_modified_to=' + encodeURIComponent(filter_date_modified_to);
    }

    window.history.pushState({}, null, 'index.php?route=sale/order&user_token={{ user_token }}' + url);

    $('#order').load('index.php?route=sale/order.list&user_token={{ user_token }}' + url);
    
    // Close the modal after filtering
    var modalElement = document.getElementById('modalFilter');
    var modal = bootstrap.Modal.getInstance(modalElement);
    if (modal) {
        modal.hide();
    }
});

$('#input-customer').autocomplete({
    'source': function(request, response) {
        $.ajax({
            url: 'index.php?route=customer/customer.autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
            dataType: 'json',
            success: function(json) {
                response($.map(json, function(item) {
                    return {
                        label: item['name'],
                        value: item['customer_id']
                    }
                }));
            }
        });
    },
    'select': function(item) {
        $('#input-customer').val(decodeHTMLEntities(item['label']));
    }
});

$('#button-reset').on('click', function(e) {
    e.preventDefault();
    $('#form-filter')[0].reset();
    var modalElement = document.getElementById('modalFilter');
    var modal = bootstrap.Modal.getInstance(modalElement);
    if (modal) {
        modal.hide();
    }
    window.history.pushState({}, null, 'index.php?route=sale/order&user_token={{ user_token }}');
    $('#order').load('index.php?route=sale/order.list&user_token={{ user_token }}');
});
//--></script>
<style>
.btn-custom-filter-white {
    background-color: #ffffff !important;
    border: 1px solid #dee4ee !important;
    color: #1c2434 !important;
    border-radius: 6px !important;
    height: 38px !important;
    padding: 0 16px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-sizing: border-box !important;
    vertical-align: middle !important;
    line-height: normal !important;
    font-weight: 500 !important;
    text-decoration: none !important;
    transition: all 0.2s ease-in-out;
}
.btn-custom-filter-white:hover {
    background-color: #f8fafc !important;
    border-color: #cbd5e1 !important;
    color: #1c2434 !important;
}
.btn-custom-filter-white i,
.btn-custom-filter-white svg {
    margin-right: 8px !important;
    margin-left: 0 !important;
    color: #1c2434 !important;
}
.btn-custom-filter-white:hover i,
.btn-custom-filter-white:hover svg {
    color: #1c2434 !important;
}
</style>
{{ footer }}
