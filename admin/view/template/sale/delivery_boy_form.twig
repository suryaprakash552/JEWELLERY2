{{ header }}{{ column_left }}
<style>
/* Custom Save and Back button styles */
.btn-custom-save {
    background-color: #465fff !important;
    border-color: #465fff !important;
    color: #ffffff !important;
    border-radius: 6px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-weight: 500 !important;
    height: 38px !important;
    padding: 0 16px !important;
    font-size: 14px !important;
    box-sizing: border-box !important;
    vertical-align: middle !important;
    line-height: normal !important;
    width: auto !important;
}
.btn-custom-save:hover {
    background-color: #3b50db !important;
    border-color: #3b50db !important;
    color: #ffffff !important;
}
.btn-custom-save i {
    margin-right: 8px !important;
    color: #ffffff !important;
}

.btn-custom-back {
    background-color: #465fff !important;
    border-color: #465fff !important;
    color: #ffffff !important;
    border-radius: 6px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-weight: 500 !important;
    height: 38px !important;
    padding: 0 16px !important;
    font-size: 14px !important;
    text-decoration: none !important;
    box-sizing: border-box !important;
    vertical-align: middle !important;
    line-height: normal !important;
    width: auto !important;
}
.btn-custom-back:hover {
    background-color: #3b50db !important;
    border-color: #3b50db !important;
    color: #ffffff !important;
}
.btn-custom-back *,
.btn-custom-back i,
.btn-custom-back svg,
.btn-custom-back svg path,
.btn-custom-back i::before,
.btn-custom-back i::after {
    color: #ffffff !important;
    fill: #ffffff !important;
    stroke: #ffffff !important;
}
.btn-custom-back i {
    margin-right: 8px !important;
}
</style>
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-delivery-boy" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary btn-custom-save"><i class="fa-solid fa-floppy-disk"></i> {{ button_save }}</button>
        <a href="{{ cancel }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light btn-custom-back"><i class="fa-solid fa-arrow-left"></i> {{ button_back }}</a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_form }}</div>
      <div class="card-body">
        <form id="form-delivery-boy" action="{{ action }}" method="post" enctype="multipart/form-data">
          <div class="row mb-3 required">
            <label for="input-name" class="col-sm-2 col-form-label">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control"/>
              {% if error_name %}
                <div class="text-danger">{{ error_name }}</div>
              {% endif %}
            </div>
          </div>
          <div class="row mb-3 required">
            <label for="input-telephone" class="col-sm-2 col-form-label">{{ entry_telephone }}</label>
            <div class="col-sm-10">
              <input type="text" name="telephone" value="{{ telephone }}" placeholder="{{ entry_telephone }}" id="input-telephone" class="form-control"/>
              {% if error_telephone %}
                <div class="text-danger">{{ error_telephone }}</div>
              {% endif %}
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="status" id="input-status" class="form-select">
                <option value="1"{% if status %} selected{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not status %} selected{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
