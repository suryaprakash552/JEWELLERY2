{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
          <button type="button" onclick="showInvoiceIframe({{ order_id }})" data-bs-toggle="tooltip" title="{{ button_invoice_print }}" class="btn btn-info btn-custom-print{% if not order_id %} disabled{% endif %}"><i class="fa-solid fa-print"></i> Print</button>
          <a href="{{ shipping }}" target="_blank" data-bs-toggle="tooltip" title="{{ button_shipping_print }}" class="btn btn-info{% if not shipping_method_code %} disabled{% endif %}"><i class="fa-solid fa-truck"></i></a>
          
        {#  <!-- NEW PAYMENT BUTTON -->#}
        {#  <button type="button" onclick="printInvoiceDirect({{ order_id }})"#}
        {#        class="btn btn-primary">#}
        {#    <i class="fa-solid fa-money-bill"></i> Payment#}
        {#</button>#}
          
          <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-primary" style="background: #465fff; border: 1px solid #465fff; color: #fff; padding: 6px 12px; border-radius: 4px; font-weight: 600;"><i class="fa-solid fa-arrow-left" style="margin-right: 4px;"></i> Back</a>
        </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card mb-3">
    <div class="card-header">
        <div class="row">
            <div class="col">
                <i class="fa-solid fa-info-circle"></i> {{ text_form }}
            </div>

            <div class="col">
                <i class="fa-solid fa-info-circle"></i>Date: {{ date_added }}
            </div>
            {# Prefer controller prepared value if present #}
            {% set display = invoice_display|default('') %}
            
            {# Build display only when invoice_display not provided #}
            {% if not display %}
                {# Prefer explicit controller vars, then order_info fields, then invoice_no #}
                {% set prefix = invoice_prefix|default(order_info.invoice_prefix|default('')) %}
                {% set raw_no = invoice_raw_no|default(order_info.invoice_no|default(invoice_no|default(''))) %}
            
                {% if raw_no is not empty %}
                    {# If raw_no already begins with prefix, use it as-is; otherwise attach prefix + '-' #}
                    {% if prefix and (raw_no|slice(0, prefix|length) != prefix) %}
                        {% set display = prefix ~ '-' ~ raw_no %}
                    {% else %}
                        {% set display = raw_no %}
                    {% endif %}
                {% elseif prefix %}
                    {# Prefix exists but no number yet (optional behaviour) #}
                    {% set display = prefix ~ '-' %}
                {% else %}
                    {% set display = '' %}
                {% endif %}
            {% endif %}
            <div class="col">
                <i class="fa-solid fa-info-circle"></i>
                {% if display %}
                    Invoice: {{ display }}
                {% else %}
                    Invoice: <span class="text-muted">Not generated</span>
                {% endif %}
            </div>
        </div>
    </div>
      <div class="card-body">
<div class="row mb-3 g-3">

    {#<!-- Invoice -->#}
    {#<div class="col">#}
    {#    <label class="custom-label">Invoice</label>#}
    {#    <div class="d-flex">-#}
    {#        <div class="form-control" style="background: #0f172a; border: 1px solid #334155; color: #fff; padding: 8px 10px;" >#}
    {#                {{ invoice.invoice_prefix }}{{ invoice.invoice_no }}#}
    {#        </div>#}
    {#    </div>#}
    {#</div>#}

    <div class="col">
        <label class="custom-label">Customer</label>
        <div class="d-flex">
            <div class="form-control" style="background-color: transparent !important; min-height: 36px; padding: 8px 10px;">
                {% if customer_id %}
                <a href="{{ customer_edit }}" target="_blank" style="color: var(--bs-link-color); text-decoration: none; font-weight: 500;">
                    {{ firstname }} {{ lastname }}
                </a>
                {% else %}
                    {{ firstname }} {{ lastname }}
                {% endif %}
            </div>

            <button type="button" 
                    data-bs-toggle="modal" 
                    data-bs-target="#modal-customer" 
                    class="btn btn-outline-primary ms-2 rounded-circle d-flex align-items-center justify-content-center p-0" style="width: 36px; height: 36px; flex-shrink: 0;">
                <i class="fa-solid fa-user"></i>
            </button>
        </div>
    </div>
    <div class="col">
        <label class="custom-label">Payment Address</label>
        <div class="d-flex">
            <div class="form-control" style="background-color: transparent !important; min-height: 36px; padding: 8px 10px;">
                {{ payment_firstname }} {{ payment_lastname }}
            </div>

            <button type="button" 
                    data-bs-toggle="modal" 
                    data-bs-target="#modal-payment-address" 
                    class="btn btn-outline-primary ms-2 rounded-circle d-flex align-items-center justify-content-center p-0" style="width: 36px; height: 36px; flex-shrink: 0;">
                <i class="fa-solid fa-indian-rupee-sign"></i>
            </button>
        </div>
    </div>

    <div class="col">
        <label class="custom-label">Store</label>
        <select id="input-store" class="form-select w-100 shadow-none" style="background-color: transparent !important; min-height: 36px; width: 100%;">
            {% for store in stores %}
                <option value="{{ store.store_id }}" {% if store.store_id == store_id %}selected{% endif %}>
                    {{ store.name }}
                </option>
            {% endfor %}
        </select>
    </div>

    <div class="col">
        <label class="custom-label">Language</label>
        <select id="input-language" class="form-select w-100 shadow-none" style="background-color: transparent !important; min-height: 36px; width: 100%;">
            {% for language in languages %}
                <option value="{{ language.code }}" {% if language.code == language_code %}selected{% endif %}>
                    {{ language.name }}
                </option>
            {% endfor %}
        </select>
    </div>

    <div class="col">
        <label class="custom-label">Currency</label>
        <select id="input-currency" class="form-select w-100 shadow-none" style="background-color: transparent !important; min-height: 36px; width: 100%;">
            {% for currency in currencies %}
                <option value="{{ currency.code }}" {% if currency.code == currency_code %}selected{% endif %}>
                    {{ currency.title }}
                </option>
            {% endfor %}
        </select>
    </div>

    <!-- Payment Address -->
    {#<div class="col">#}
    {#    <label class="custom-label">Payment Address</label>#}
    {#    <div class="d-flex">#}
    {#        <div class="form-control" >#}
    {#            {{ payment_firstname }} {{ payment_lastname }}#}
    {#        </div>#}
    {#        <button type="button" #}
    {#                data-bs-toggle="modal" #}
    {#                data-bs-target="#modal-payment-address" #}
    {#                class="btn btn-outline-primary btn-sm ms-2">#}
    {#            <i class="fa-solid fa-cog"></i>#}
    {#        </button>#}
    {#    </div>#}
    {#</div>#}

    <!-- Payment Method -->
    <div class="col">
        <label class="custom-label">Credit Points</label>
        <div class="form-control" style="background-color: transparent !important; min-height: 36px; padding: 8px 10px;">
           {{ invoice.credit_points }}
        </div>
    </div>

</div>

         
        <div class="row g-4 mt-1">
          <!-- Left Column: Product Table -->
          <div class="col-lg-8 col-md-7 col-12">
            <form id="form-cart">
              <div class="table-responsive border rounded-3">
                <table class="table table-bordered table-hover m-0 align-middle">
                  <thead>
                    <tr class="border-bottom" style="background-color: rgba(128, 128, 128, 0.05);">
                      <th class="py-3 ps-3 text-secondary" style="font-size: 12px; font-weight: 700; letter-spacing: 0.5px;">PRODUCT</th>
                      <th class="text-end py-3 text-secondary" style="font-size: 12px; font-weight: 700; letter-spacing: 0.5px;">QUANTITY</th>
                      <th class="text-end py-3 text-secondary" style="font-size: 12px; font-weight: 700; letter-spacing: 0.5px;">UNIT PRICE</th>
                      <th class="text-end py-3 text-secondary" style="font-size: 12px; font-weight: 700; letter-spacing: 0.5px;">TOTAL</th>
                      <th class="text-center py-3 pe-3 text-secondary" style="font-size: 12px; font-weight: 700; letter-spacing: 0.5px; width: 80px;">ACTION</th>
                    </tr>
                  </thead>
                  <tbody id="order-product">
                    {% set order_product_row = 0 %}
                    {% if order_products %}
                      {% for order_product in order_products %}
                        <tr class="border-bottom">
                          <td class="py-3 ps-3">
                            <a href="{{ order_product.product_edit }}" target="_blank" class="fw-bold text-decoration-none text-primary" style="font-size: 14px;">{{ order_product.name }}</a>
                            <div id="error-product-{{ order_product_row }}-product" class="invalid-feedback mt-0"></div>
                            <ul class="list-unstyled mb-0 text-muted mt-1" style="font-size: 12px;">
                              <li>
                                <span> - {{ text_model }}: {{ order_product.model }}</span>
                              </li>
                              {% for option in order_product.option %}
                                {% if option.type != 'file' %}
                                  <li>
                                    <span> - {{ option.name }}: {{ option.value }}</span>
                                    <div id="error-product-{{ order_product_row }}-option-{{ option.product_option_id }}" class="invalid-feedback mt-0"></div>
                                  </li>
                                {% else %}
                                  <li>
                                    <span> - {{ option.name }}: <a href="{{ option.href }}">{{ option.filename }}</a></span>
                                    <div id="error-product-{{ order_product_row }}-option-{{ option.product_option_id }}" class="invalid-feedback mt-0"></div>
                                  </li>
                                {% endif %}
                              {% endfor %}
                              {% if order_product.subscription_plan_id %}
                                <li>
                                  <span> - {{ text_subscription }}: {% if order_product.subscription_edit %}<a href="{{ order_product.subscription_edit }}" target="_blank">{{ order_product.subscription_plan }}</a>{% else %}{{ order_product.subscription_plan }}{% endif %}</span>
                                  <div id="error-product-{{ order_product_row }}-subscription" class="invalid-feedback mt-0"></div>
                                </li>
                              {% endif %}
                              {% if order_product.reward %}
                                <li>
                                  <span> - {{ text_points }}: {{ order_product.reward }}</span>
                                </li>
                              {% endif %}
                            </ul>
                            <input type="hidden" name="product[{{ order_product_row }}][product_id]" value="{{ order_product.product_id }}"/> <input type="hidden" name="product[{{ order_product_row }}][quantity]" value="{{ order_product.quantity }}"/>
                            {% for option in order_product.option %}
                              {% if option.type == 'select' or option.type == 'radio' %}
                                <input type="hidden" name="product[{{ order_product_row }}][option][{{ option.product_option_id }}]" value="{{ option.product_option_value_id }}"/>
                              {% endif %}
                              {% if option.type == 'checkbox' %}
                                <input type="hidden" name="product[{{ order_product_row }}][option][{{ option.product_option_id }}][]" value="{{ option.product_option_value_id }}"/>
                              {% endif %}
                              {% if option.type == 'text' or option.type == 'textarea' or option.type == 'file' or option.type == 'date' or option.type == 'datetime' or option.type == 'time' %}
                                <input type="hidden" name="product[{{ order_product_row }}][option][{{ option.product_option_id }}]" value="{{ option.value }}"/>
                              {% endif %}
                            {% endfor %}
                            <input type="hidden" name="product[{{ order_product_row }}][subscription_plan_id]" value="{{ order_product.subscription_plan_id }}"/>
                          </td>
                          <td class="text-end py-3 fw-bold text-dark" style="font-size: 14px;">{{ order_product.quantity }}</td>
                          <td class="text-end py-3 text-muted" style="font-size: 14px;">{{ order_product.price }}</td>
                          <td class="text-end py-3 fw-bold text-dark" style="font-size: 14px;">{{ order_product.total }}</td>
                          <td class="text-center py-3 pe-3">
                              <button type="button" data-bs-toggle="tooltip" title="Cancel" class="btn btn-danger rounded-circle p-0 d-inline-flex align-items-center justify-content-center shadow-sm button-product-cancel" data-order-product-id="{{ order_product.order_product_id }}" style="width: 30px; height: 30px; background-color: #dc3545; border-color: #dc3545;">
                                  <i class="fa-solid fa-xmark text-white" style="font-size: 13px;"></i>
                              </button>
                          </td>
                        </tr>
                        {% set order_product_row = order_product_row + 1 %}
                      {% endfor %}
                    {% else %}
                      <tr>
                        <td colspan="5" class="text-center text-muted py-4">{{ text_no_results }}</td>
                      </tr>
                    {% endif %}
                  </tbody>
                  <tfoot>
                    <tr class="border-top" style="background-color: rgba(128, 128, 128, 0.05);">
                      <td colspan="5" class="py-3 px-3">
                        <div class="d-flex justify-content-between align-items-center">
                          <div style="font-size: 13px; color: #64748b; font-weight: 500;">
                              Showing 1 to {{ order_products|length }} of {{ order_products|length }} products
                          </div>
                          <nav>
                              <ul class="pagination pagination-sm m-0">
                                  <li class="page-item disabled"><span class="page-link" style="border-radius: 4px 0 0 4px; border-color: #e2e8f0; color: #94a3b8;"><i class="fa-solid fa-chevron-left"></i></span></li>
                                  <li class="page-item active"><span class="page-link" style="background-color: #3b82f6; border-color: #3b82f6; font-weight: 600; padding-left: 12px; padding-right: 12px;">1</span></li>
                                  <li class="page-item disabled"><span class="page-link" style="border-radius: 0 4px 4px 0; border-color: #e2e8f0; color: #94a3b8;"><i class="fa-solid fa-chevron-right"></i></span></li>
                              </ul>
                          </nav>
                        </div>
                      </td>
                    </tr>
                  </tfoot>
                </table>
              </div>
            </form>

            {% if not invoice and order_totals %}
            <div class="card shadow-sm border mt-3" style="border-radius: 8px; overflow: hidden;">
                <div class="card-body p-0">
                    <table class="table table-hover m-0 align-middle">
                      <tbody id="order-total">
                        {% for order_total in order_totals %}
                          <tr class="border-bottom">
                            <td class="ps-3 py-2 text-secondary"><strong>{{ order_total.title }}</strong></td>
                            <td class="pe-3 py-2 text-end" style="width: 1px;">{{ order_total.text }}</td>
                          </tr>
                        {% endfor %}
                      </tbody>
                    </table>
                </div>
            </div>
            {% endif %}
          </div>

          <!-- Right Column: Subtotals / Summary -->
          <div class="col-lg-4 col-md-5 col-12">
            {% if invoice %}
            <div class="card shadow-sm border" style="border-radius: 8px; overflow: hidden;">
                <div class="card-body p-0">
                    <table class="table table-hover m-0 align-middle">
                      <tbody>
                        <tr class="border-bottom">
                          <td class="ps-3 py-3 text-secondary" style="font-size: 13px; font-weight: 500;">Subtotal</td>
                          <td class="pe-3 py-3 text-end fw-bold text-dark" style="font-size: 14px;">₹ {{ invoice.sub_total }}</td>
                        </tr>

                        <tr class="border-bottom">
                          <td class="ps-3 py-2 text-secondary" style="font-size: 13px;">Discount</td>
                          <td class="pe-3 py-2 text-end text-dark" style="font-size: 14px;">₹ {{ invoice.discount }}</td>
                        </tr>

                        <tr class="border-bottom" style="background-color: rgba(128, 128, 128, 0.05);">
                          <td class="ps-3 py-2 text-secondary" style="font-size: 13px; font-weight: 600;">Subtotal After Discount</td>
                          <td class="pe-3 py-2 text-end" style="font-size: 14px; font-weight: 600; color: var(--bs-body-color);">
                            ₹ {{ invoice.sub_total - invoice.discount }}
                          </td>
                        </tr>

                        <tr class="border-bottom">
                          <td class="ps-3 py-2 text-secondary" style="font-size: 13px;">Total Tax</td>
                          <td class="pe-3 py-2 text-end" style="font-size: 14px; color: var(--bs-body-color);">
                            ₹ {{ invoice.total_tax }}
                          </td>
                        </tr>

                        <tr class="border-bottom" style="background-color: rgba(128, 128, 128, 0.05);">
                          <th class="ps-3 py-3 text-primary" style="font-size: 14px; font-weight: 700;">Total Amount</th>
                          <th class="pe-3 py-3 text-end text-primary" style="font-size: 15px; font-weight: 700;">₹ {{ invoice.total_received }}</th>
                        </tr>

                        <tr class="border-bottom">
                          <td class="ps-3 py-2 text-secondary" style="font-size: 13px;">Cash Amount</td>
                          <td class="pe-3 py-2 text-end text-dark" style="font-size: 14px;">₹ {{ invoice.cash_amount }}</td>
                        </tr>

                        <tr class="border-bottom">
                          <td class="ps-3 py-2 text-secondary" style="font-size: 13px;">UPI Amount</td>
                          <td class="pe-3 py-2 text-end text-dark" style="font-size: 14px;">₹ {{ invoice.upi_amount }}</td>
                        </tr>

                        <tr class="border-bottom">
                          <td class="ps-3 py-2 text-secondary" style="font-size: 13px;">UPI Ref</td>
                          <td class="pe-3 py-2 text-end text-dark" style="font-size: 14px;">{{ invoice.upi_ref ?: '-' }}</td> 
                        </tr>

                        <tr class="border-bottom">
                          <td class="ps-3 py-2 text-secondary" style="font-size: 13px;">Coupon</td>
                          <td class="pe-3 py-2 text-end text-dark" style="font-size: 14px;">{{ invoice.coupon ?: '-' }}</td>
                        </tr>

                        <tr>
                          <td class="ps-3 py-3 fw-bold {% if invoice.pending_amount > 0 %}text-danger{% else %}text-success{% endif %}" style="font-size: 14px;">
                            Due Amount
                          </td>
                          <td class="pe-3 py-3 text-end fw-bold {% if invoice.pending_amount > 0 %}text-danger{% else %}text-success{% endif %}" style="font-size: 15px;">
                            ₹ {{ invoice.pending_amount }}
                          </td>
                        </tr>
                      </tbody>
                    </table>
                </div>
            </div>
            {% endif %}
          </div>
        </div>
        <!-- Invoice iframe (off-screen, used only for printing) -->
        <div id="invoiceBox">
            <iframe id="invoiceFrame" style="position:fixed; left:-9999px; top:-9999px; width:800px; height:900px; border:none; display:block;"></iframe>
        </div>
      </div>
    </div>
    <div class="card mb-3">
      <div class="card-header"><i class="fa-solid fa-comment"></i> {{ text_history }}</div>
      <div class="card-body">
        <ul class="nav nav-tabs">
          <li class="nav-item"><a href="#tab-history" data-bs-toggle="tab" class="nav-link active">{{ tab_history }}</a></li>
          <li class="nav-item"><a href="#tab-additional" data-bs-toggle="tab" class="nav-link">{{ tab_additional }}</a></li>
          {% for tab in tabs %}
            <li class="nav-item"><a href="#tab-{{ tab.code }}" data-bs-toggle="tab" class="nav-link">{{ tab.title }}</a></li>
          {% endfor %}
        </ul>
        <div class="tab-content">
          <div id="tab-history" class="tab-pane active">
            <fieldset>
              <legend>{{ text_history }}</legend>
              <div id="history">{{ history }}</div>
            </fieldset>
            
            <!-- Order Tracking -->
            {% set current_step = 1 %}
            {% if order_status_id == 1 %} {% set current_step = 1 %} {% endif %}
            {% if order_status_id == 2 %} {% set current_step = 2 %} {% endif %}
            {% if order_status_id == 3 %} {% set current_step = 3 %} {% endif %}
            {% if order_status_id == 15 %} {% set current_step = 4 %} {% endif %}
            {% if order_status_id >= 5 and order_status_id != 15 %} {% set current_step = 5 %} {% endif %}

            {% set progress_width = ((current_step - 1) * 25) ~ '%' %}

            {% set next_status_id = '' %}
            {% set next_status_name = '' %}
            {% if current_step == 1 %}
                {% set next_status_id = 2 %}
                {% set next_status_name = 'Packed' %}
            {% elseif current_step == 2 %}
                {% set next_status_id = 3 %}
                {% set next_status_name = 'Shipped' %}
            {% elseif current_step == 3 %}
                {% set next_status_id = 15 %}
                {% set next_status_name = 'Delivered' %}
            {% elseif current_step == 4 %}
                {% set next_status_id = 5 %}
                {% set next_status_name = 'Completed' %}
            {% endif %}

            <fieldset class="mb-4 mt-2">
                <div class="card shadow-sm">
                    <div class="card-header fw-bold" style="padding: 12px 20px;">
                        <i class="fa-solid fa-truck text-primary me-2"></i> Order Tracking
                    </div>
                    <div class="card-body p-4">
                        <!-- Stepper -->
                        <div class="position-relative mb-4 mt-2">
                            <!-- Progress Line -->
                            <div class="progress position-absolute" style="height: 4px; top: 18px; left: 10%; right: 10%; z-index: 1;">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: {{ progress_width }};" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            
                            <!-- Steps -->
                            <div class="d-flex justify-content-between position-relative" style="z-index: 2;">
                            {% set steps = [
                                {id: 1, name: 'Order Placed'},
                                {id: 2, name: 'Packed'},
                                {id: 3, name: 'Shipped'},
                                {id: 4, name: 'Delivered'},
                                {id: 5, name: 'Completed'}
                            ] %}
                            {% for step in steps %}
                                <div class="text-center" style="width: 20%;">
                                {% if current_step > step.id %}
                                    <!-- Completed Step -->
                                    <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle mb-2 shadow-sm" style="width: 40px; height: 40px;">
                                        <i class="fa-solid fa-check" style="color: #ffffff !important; fill: #ffffff !important;"></i>
                                    </div>
                                    <div style="font-size: 13px; font-weight: bold; color: #0d6efd;">{{ step.name }}</div>
                                {% elseif current_step == step.id %}
                                    <!-- Current Step -->
                                    <div class="d-inline-flex align-items-center justify-content-center bg-transparent border border-primary rounded-circle mb-2 shadow-sm" style="width: 40px; height: 40px; border-width: 3px !important;">
                                        <div class="bg-primary rounded-circle" style="width: 14px; height: 14px;"></div>
                                    </div>
                                    <div style="font-size: 13px; font-weight: bold; color: #0d6efd;">{{ step.name }}</div>
                                {% else %}
                                    <!-- Future Step -->
                                    <div class="d-inline-flex align-items-center justify-content-center bg-transparent border border-secondary rounded-circle mb-2" style="width: 40px; height: 40px; border-width: 2px !important;">
                                    </div>
                                    <div style="font-size: 13px; font-weight: 500; color: #6c757d;">{{ step.name }}</div>
                                {% endif %}
                                </div>
                            {% endfor %}
                            </div>
                        </div>

                        {% if next_status_id %}
                        <!-- Next Step Box -->
                        <div class="d-flex align-items-center justify-content-between p-3 mt-4 rounded border" style="background-color: rgba(128, 128, 128, 0.05);">
                            <div class="d-flex align-items-center">
                                <div class="d-inline-flex align-items-center justify-content-center text-white rounded-circle me-3" style="width: 40px; height: 40px; background-color: #465fff;">
                                    <i class="fa-solid fa-sync" style="color: #ffffff !important; fill: #ffffff !important;"></i>
                                </div>
                                <div>
                                    <div style="font-size: 11px; color: #64748b; text-transform: uppercase; font-weight: bold; letter-spacing: 0.5px;">Next step</div>
                                    <div style="font-size: 15px; font-weight: bold; margin-top: 2px; color: var(--bs-heading-color);">Mark as {{ next_status_name }}</div>
                                </div>
                            </div>
                            <button type="button" id="button-update-tracker" class="btn btn-primary px-4 fw-bold shadow-sm" onclick="updateOrderStatus({{ next_status_id }});">Update</button>
                        </div>
                        {% else %}
                        <div class="alert alert-success mt-4 mb-0 fw-bold"><i class="fa-solid fa-check-circle me-2"></i> This order is Completed.</div>
                        {% endif %}
                    </div>
                </div>
            </fieldset>

            <script>
            function updateOrderStatus(status_id) {
                // Set the hidden order status dropdown to the new status
                $('#input-order-status').val(status_id);
                
                // Trigger the history form submit via AJAX using OpenCart 4 API call method
                $.ajax({
                    url: 'index.php?route=sale/order.call&user_token={{ user_token }}&order_id={{ order_id }}&store_id={{ store_id }}&call=history_add',
                    type: 'post',
                    dataType: 'json',
                    data: $('#form-history').serialize(),
                    beforeSend: function() {
                        $('#button-update-tracker').prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin"></i> Updating...');
                    },
                    success: function(json) {
                        if (json['error']) {
                            alert(json['error']);
                            $('#button-update-tracker').prop('disabled', false).html('Update');
                        }
                        if (json['success']) {
                            // Reload the current page to update the tracker and history table in place
                            window.location.reload();
                        }
                    },
                    error: function(xhr, ajaxOptions, thrownError) {
                        alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                        $('#button-update-tracker').prop('disabled', false).html('Update');
                    }
                });
            }

            $(document).on('click', '#button-history', function(e) {
                e.preventDefault();
                $.ajax({
                    url: 'index.php?route=sale/order.call&user_token={{ user_token }}&order_id={{ order_id }}&store_id={{ store_id }}&call=history_add',
                    type: 'post',
                    dataType: 'json',
                    data: $('#form-history').serialize(),
                    beforeSend: function() {
                        $('#button-history').prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin"></i> Submitting...');
                    },
                    success: function(json) {
                        if (json['error']) {
                            alert(json['error']);
                            $('#button-history').prop('disabled', false).html('Submit');
                        }
                        if (json['success']) {
                            window.location.reload();
                        }
                    },
                    error: function(xhr, ajaxOptions, thrownError) {
                        alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                        $('#button-history').prop('disabled', false).html('Submit');
                    }
                });
            });

            $(document).on('click', '.button-product-cancel', function(e) {
                e.preventDefault();
                var order_product_id = $(this).attr('data-order-product-id');
                var button_el = $(this);
                
                if (confirm('Are you sure you want to cancel this product from the order?')) {
                    $.ajax({
                        url: 'index.php?route=sale/order.cancelProduct&user_token={{ user_token }}',
                        type: 'post',
                        dataType: 'json',
                        data: {
                            order_id: '{{ order_id }}',
                            order_product_id: order_product_id
                        },
                        beforeSend: function() {
                            button_el.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin text-white"></i>');
                        },
                        success: function(json) {
                            if (json['error']) {
                                alert(json['error']);
                                button_el.prop('disabled', false).html('<i class="fa-solid fa-xmark text-white" style="font-size: 13px;"></i>');
                            }
                            if (json['success']) {
                                window.location.reload();
                            }
                        },
                        error: function(xhr, ajaxOptions, thrownError) {
                            alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                            button_el.prop('disabled', false).html('<i class="fa-solid fa-xmark text-white" style="font-size: 13px;"></i>');
                        }
                    });
                }
            });
            </script>

