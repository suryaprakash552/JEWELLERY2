{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header" style="padding-top: 24px; padding-bottom: 24px; margin-bottom: 0;">
    <div class="container-fluid d-flex justify-content-between align-items-center">
      <h2 style="margin: 0; font-size: 20px; font-weight: 600; line-height: 28px; color: var(--bs-heading-color) !important; font-family: 'Outfit', 'Inter', sans-serif;">{{ heading_title }}</h2>
      <ol class="breadcrumb" style="margin: 0; padding: 0; --bs-breadcrumb-divider: '>';">
        {% for breadcrumb in breadcrumbs %}
          {% if loop.last %}
            <li class="breadcrumb-item active" style="color: var(--bs-heading-color) !important;">{{ breadcrumb.text }}</li>
          {% else %}
            <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}" style="color: #64748b !important; text-decoration: none;">{{ breadcrumb.text }}</a></li>
          {% endif %}
        {% endfor %}
      </ol>
    </div>
  </div>
  
  <div class="container-fluid">
      <div class="col-12">
        <div class="card">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span style="color: var(--bs-heading-color) !important; font-weight: 600; font-family: 'Outfit', 'Inter', sans-serif; font-size: 15px; display: inline-flex; align-items: center;"><i class="fa-solid fa-list" style="margin-right: 8px; color: var(--bs-heading-color) !important;"></i>{{ text_list }}</span>
            <div class="d-flex gap-2 align-items-center">
              <button type="button" id="button-repair" data-bs-toggle="tooltip" title="{{ button_rebuild }}" class="btn btn-warning" style="border-radius: 50%; width: 36px; height: 36px; padding: 0; display: inline-flex; align-items: center; justify-content: center; background-color: #3b82f6; border-color: #3b82f6; color: #ffffff;"><i class="fa-solid fa-rotate"></i></button>
              <button type="button" data-bs-toggle="modal" data-bs-target="#modal-filter-category" class="btn btn-custom-filter-white"><i class="fa-solid fa-sliders"></i> Filter</button>
              <a href="{{ add }}" data-bs-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary btn-custom-add"><i class="fa-solid fa-plus"></i> Add</a>
              <button type="submit" form="form-category" formaction="{{ delete }}" data-bs-toggle="tooltip" title="{{ button_delete }}" onclick="if ($('input[name*=\'selected\']:checked').length == 0) { alert('Please select at least one item to delete.'); return false; } return confirm('{{ text_confirm }}');" class="btn btn-danger btn-custom-delete"><i class="fa-solid fa-trash-can text-white"></i> Delete</button>
            </div>
          </div>
          <div id="category" class="card-body">{{ list }}</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="modal-filter-category" tabindex="-1" aria-labelledby="modal-filter-category-label" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modal-filter-category-label"><i class="fa-solid fa-filter"></i> {{ text_filter }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="form-filter">
          <div class="mb-3">
            <label class="form-label">{{ entry_name }}</label>
            <input type="text" name="filter_name" value="{{ filter_name }}" placeholder="{{ entry_name }}" id="input-name" data-oc-target="autocomplete-name" class="form-control" autocomplete="off"/>
            <ul id="autocomplete-name" class="dropdown-menu"></ul>
          </div>
          <div class="mb-3">
            <label for="input-status" class="form-label">{{ entry_status }}</label>
            <select name="filter_status" id="input-status" class="form-select">
              <option value=""></option>
              <option value="1"{% if filter_status == '1' %} selected{% endif %} style="color:black;">{{ text_enabled }}</option>
              <option value="0"{% if filter_status == '0' %} selected{% endif %} style="color:black;">{{ text_disabled }}</option>
            </select>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" id="button-reset" class="btn btn-outline-secondary"><i class="fa-solid fa-filter-circle-xmark"></i> Reset</button>
        <button type="button" id="button-filter" data-bs-dismiss="modal" class="btn btn-custom-filter-white"><i class="fa-solid fa-sliders"></i> {{ button_filter }}</button>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript"><!--
$('#category').on('click', 'thead a, .pagination a', function(e) {
    e.preventDefault();

    $('#category').load(this.href);
});

$('#button-repair').on('click', function(e) {
    e.preventDefault();

    var element = this;

    $.ajax({
        url: 'index.php?route=catalog/category.repair&user_token={{ user_token }}',
        dataType: 'json',
        beforeSend: function() {
            $(element).button('loading');
        },
        complete: function() {
            $(element).button('reset');
        },
        success: function(json) {
            if (json['error']) {
                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }

            if (json['success']) {
                $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-check-circle"></i> ' + json['success'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');

                $('#category').load('index.php?route=catalog/category.list&user_token={{ user_token }}');
            }
        },
        error: function(xhr, ajaxOptions, thrownError) {
            console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});

$('#button-filter').on('click', function() {
    var url = '';

    var filter_name = $('#input-name').val();

    if (filter_name !== '') {
        url += '&filter_name=' + encodeURIComponent(filter_name);
    }

    var filter_status = $('#input-status').val();

    if (filter_status !== '') {
        url += '&filter_status=' + filter_status;
    }

    window.history.pushState({}, null, 'index.php?route=catalog/category&user_token={{ user_token }}' + url);

    $('#category').load('index.php?route=catalog/category.list&user_token={{ user_token }}' + url);
});

$('#input-name').autocomplete({
    'source': function(request, response) {
        $.ajax({
            url: 'index.php?route=catalog/category.autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
            dataType: 'json',
            success: function(json) {
                json.unshift({
                    name: '{{ text_none }}',
                    category_id: '',
                });

                response($.map(json, function(item) {
                    return {
                        label: item['name'],
                        value: item['category_id']
                    }
                }));
            }
        });
    },
    'select': function(item) {
        if (item['value']) {
            $('#input-name').val(decodeHTMLEntities(item['label']));
        } else {
            $('#input-name').val('');
        }
    }
});
$('#button-reset').on('click', function() {
    $('#input-name').val('');
    $('#input-status').val('').trigger('change');
    $('#modal-filter-category').modal('hide');
    window.history.pushState({}, null, 'index.php?route=catalog/category&user_token={{ user_token }}');
    $('#category').load('index.php?route=catalog/category.list&user_token={{ user_token }}');
});
//--></script>
{{ footer }}
