<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}">
<head>
  <script>
    // Initialize theme from local storage
    const savedTheme = localStorage.getItem('theme') || 'light';
    document.documentElement.setAttribute('data-bs-theme', savedTheme);
  </script>
  <meta charset="UTF-8"/>
  <title>{{ title }}</title>
  <base href="{{ base }}"/>
  {% if description %}
    <meta name="description" content="{{ description }}"/>
  {% endif %}
  {% if keywords %}
    <meta name="keywords" content="{{ keywords }}"/>
  {% endif %}
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no"/>
  <meta http-equiv="cache-control" content="no-cache">
  <meta http-equiv="expires" content="0">
  <link href="{{ bootstrap }}" rel="stylesheet" media="screen"/>
  <link href="{{ icons }}" rel="stylesheet" type="text/css"/>
  <link href="{{ stylesheet }}?v=1.6" rel="stylesheet" type="text/css"/>
  <script src="{{ jquery }}" type="text/javascript"></script>
  <script type="text/javascript" src="view/javascript/common.js?v=1.1"></script>
  {% for style in styles %}
    <link type="text/css" href="{{ style.href }}" rel="{{ style.rel }}" media="{{ style.media }}"/>
  {% endfor %}
  {% for link in links %}
    <link href="{{ link.href }}" rel="{{ link.rel }}"/>
  {% endfor %}
  {% for script in scripts %}
    <script type="text/javascript" src="{{ script.href }}"></script>
  {% endfor %}
</head>
<body>
    <div id="sidebar-overlay"></div>
<div id="alert"></div>
<div id="container">
  <header id="header" class="navbar navbar-expand navbar-light bg-light">
    <div class="container-fluid">


      {% if logged %}
        <button type="button" id="button-menu" class="btn btn-link d-inline-block" style="font-size: 20px; color: #64748b; padding: 5px 15px;"><i class="fa-solid fa-bars"></i></button>
        <ul class="nav navbar-nav ms-auto">
          <li class="nav-item">
            <a href="#" id="theme-toggle" class="nav-link" title="Toggle Theme" style="width: 34px; height: 34px; border-radius: 50%; background-color: #ffffff; display: flex; align-items: center; justify-content: center; margin-top: 14px; margin-right: 10px; color: #8a99af; padding: 0; border: 1px solid #e2e8f0;">
              <svg id="icon-sun" style="display: none;" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
              <svg id="icon-moon" style="display: none;" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            </a>
          </li>
          <li id="nav-notification" class="nav-item dropdown">
            <a href="#" data-bs-toggle="dropdown" class="nav-link dropdown-toggle" style="width: 34px; height: 34px; border-radius: 50%; background-color: #ffffff; display: flex; align-items: center; justify-content: center; margin-top: 14px; margin-right: 10px; color: #8a99af; padding: 0; border: 1px solid #e2e8f0; position: relative;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
              {% if notification_total %} <span class="badge bg-danger" style="position: absolute; top: 1px; right: 1px; border-radius: 50%; width: 10px; height: 10px; padding: 0; border: 2px solid #ffffff;"></span>{% endif %}
            </a>
            <div class="dropdown-menu dropdown-menu-end">
              {% if notifications %}
                {% for notification in notifications %}
                  <a href="{{ notification.href }}" data-bs-toggle="modal" class="dropdown-item">{{ notification.title }}</a>
                {% endfor %}
                <a href="{{ notification_all }}" class="dropdown-item text-center text-primary">{{ text_notification_all }}</a>
              {% else %}
                <span class="dropdown-item text-center">{{ text_no_results }}</span>
              {% endif %}
            </div>
          </li>



          <li id="nav-profile" class="nav-item dropdown" style="margin-left: 0px;">
            <a href="#" data-bs-toggle="dropdown" class="nav-link dropdown-toggle"><img src="{{ logoimage }}" alt="{{ firstname }} {{ lastname }}" title="{{ firstname }} {{ lastname }}" class="rounded-circle" style="width: 40px; height: 40px;"/><span class="d-none d-md-inline d-lg-inline" style="color: var(--bs-heading-color); font-weight: 500;">&nbsp;&nbsp;&nbsp;{{ firstname }} {{ lastname }} <i class="fa-solid fa-chevron-down fa-fw" style="font-size: 12px; margin-left: 5px;"></i></span></a>
            <div class="dropdown-menu dropdown-menu-end profile-dropdown" style="width: 250px; padding: 0; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); border: 1px solid var(--bs-border-color); background-color: var(--card-bg); margin-top: 15px; overflow: hidden;">
              <div style="padding: 15px 20px; border-bottom: 1px solid var(--bs-border-color);">
                <div style="font-weight: 600; font-size: 15px; color: var(--bs-heading-color); margin-bottom: 2px;">{{ firstname }} {{ lastname }}</div>
                <div style="font-size: 13px; color: var(--bs-body-color);">{{ email }}</div>
              </div>
              <div style="padding: 10px 0;">
                <a href="{{ profile }}" class="dropdown-item" style="padding: 10px 20px; font-size: 14px; display: flex; align-items: center; gap: 12px; color: var(--bs-body-color); transition: all 0.2s;"><i class="fa-regular fa-user fa-fw" style="font-size: 18px;"></i> Edit profile</a>
                <a href="{{ setting_store }}" class="dropdown-item" style="padding: 10px 20px; font-size: 14px; display: flex; align-items: center; gap: 12px; color: var(--bs-body-color); transition: all 0.2s;"><i class="fa-solid fa-gear fa-fw" style="font-size: 18px;"></i> Account settings</a>
                <a href="https://forum.opencart.com" target="_blank" class="dropdown-item" style="padding: 10px 20px; font-size: 14px; display: flex; align-items: center; gap: 12px; color: var(--bs-body-color); transition: all 0.2s;"><i class="fa-solid fa-circle-info fa-fw" style="font-size: 18px;"></i> Support</a>
              </div>
              <div id="nav-language" style="border-top: 1px solid var(--bs-border-color); padding-bottom: 5px;">
                {{ language }}
              </div>
              <div style="padding: 5px 0; border-top: 1px solid var(--bs-border-color);">
                <a href="{{ logout }}" class="dropdown-item" style="padding: 10px 20px; font-size: 14px; display: flex; align-items: center; gap: 12px; color: var(--bs-body-color); transition: all 0.2s;"><i class="fa-solid fa-arrow-right-from-bracket fa-fw" style="font-size: 18px;"></i> Sign out</a>
              </div>
            </div>
          </li>
        </ul>
      {% endif %}
    </div>
  </header>

<script>
  $(document).ready(function() {
    const $toggleBtn = $('#theme-toggle');
    const $icon = $toggleBtn.find('i');
    
    // Set initial icon based on current theme
    const currentTheme = document.documentElement.getAttribute('data-bs-theme');
    if (currentTheme === 'light') {
      $('#icon-sun').hide();
      $('#icon-moon').show();
      $toggleBtn.css({'background-color': '#ffffff', 'border-color': '#e2e8f0'});
      $('#nav-notification a.dropdown-toggle').css({'background-color': '#ffffff', 'border-color': '#e2e8f0'});
      $('#nav-notification a.dropdown-toggle .badge').css('border-color', '#ffffff');
    } else {
      $('#icon-moon').hide();
      $('#icon-sun').show();
      $toggleBtn.css({'background-color': '#313d4a', 'border-color': '#3d4d60'});
      $('#nav-notification a.dropdown-toggle').css({'background-color': '#313d4a', 'border-color': '#3d4d60'});
      $('#nav-notification a.dropdown-toggle .badge').css('border-color', '#313d4a');
    }
    
    $toggleBtn.on('click', function(e) {
      e.preventDefault();
      const newTheme = document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
      
      // Update HTML attribute
      document.documentElement.setAttribute('data-bs-theme', newTheme);
      
      // Save to localStorage
      localStorage.setItem('theme', newTheme);
      
      // Update icon
      if (newTheme === 'dark') {
        $('#icon-moon').hide();
        $('#icon-sun').show();
        $toggleBtn.css({'background-color': '#313d4a', 'border-color': '#3d4d60'});
        $('#nav-notification a.dropdown-toggle').css({'background-color': '#313d4a', 'border-color': '#3d4d60'});
        $('#nav-notification a.dropdown-toggle .badge').css('border-color', '#313d4a');
      } else {
        $('#icon-sun').hide();
        $('#icon-moon').show();
        $toggleBtn.css({'background-color': '#ffffff', 'border-color': '#e2e8f0'});
        $('#nav-notification a.dropdown-toggle').css({'background-color': '#ffffff', 'border-color': '#e2e8f0'});
        $('#nav-notification a.dropdown-toggle .badge').css('border-color', '#ffffff');
      }
    });
  });
</script>
<script>
/* ============================================================
   GLOBAL PAGE HEADER TRANSFORMER
   Matches Category page layout on ALL pages:
   PAGE HEADER: [Title (left)]  |  [Breadcrumb (right)]
   CARD HEADER: [Card Title]    |  [Action Buttons (right)]
   ============================================================ */
document.addEventListener('DOMContentLoaded', function() {

  /* ---- PART A: Fix ALL card-headers to be left-aligned flex ---- */
  document.querySelectorAll('.card-header, .panel-heading').forEach(function(ch) {
    // Skip if already a flex layout (category page etc.)
    if (ch.classList.contains('d-flex') || ch.dataset.chFixed) return;

    // If card-header has no .card-title-text wrapper yet, wrap existing content
    if (!ch.querySelector('.card-title-text') && !ch.querySelector('.page-actions')) {
      var titleSpan = document.createElement('span');
      titleSpan.className = 'card-title-text';
      // Move ALL child nodes into the span
      while (ch.firstChild) {
        titleSpan.appendChild(ch.firstChild);
      }
      ch.appendChild(titleSpan);
    }
    ch.dataset.chFixed = '1';
  });

  /* ---- PART B: Page-header transformer ---- */
  document.querySelectorAll('.page-header .container-fluid').forEach(function(container) {
    // Skip if already transformed
    if (container.classList.contains('d-flex') || container.classList.contains('ph-flex')) return;

    var h1         = container.querySelector(':scope > h1');
    var breadcrumb = container.querySelector(':scope > ol.breadcrumb, :scope > ul.breadcrumb');
    var floatEnd   = container.querySelector(':scope > .float-end');

    // Only run on old-style headers
    if (!h1 && !breadcrumb) return;

    // Step 1: Mark last breadcrumb item as active
    if (breadcrumb) {
      var items = breadcrumb.querySelectorAll('li.breadcrumb-item');
      if (items.length > 0) items[items.length - 1].classList.add('active');
    }

    // Step 2: Try to move action buttons into the card-header below
    var buttonsMoved = false;
    if (floatEnd) {
      var pageHeader = container.closest('.page-header');
      var nextEl = pageHeader ? pageHeader.nextElementSibling : null;
      var cardHeader = null;

      while (nextEl && !cardHeader) {
        cardHeader = nextEl.querySelector('.card-header, .panel-heading');
        if (!cardHeader) nextEl = nextEl.nextElementSibling;
      }

      if (cardHeader) {
        // Ensure the card-header title content is already wrapped
        if (!cardHeader.querySelector('.card-title-text')) {
          var titleSpan = document.createElement('span');
          titleSpan.className = 'card-title-text';
          while (cardHeader.firstChild) {
            titleSpan.appendChild(cardHeader.firstChild);
          }
          cardHeader.appendChild(titleSpan);
        }
        // Now append action buttons
        var actionsDiv = document.createElement('div');
        actionsDiv.className = 'page-actions';
        Array.from(floatEnd.children).forEach(function(child) {
          actionsDiv.appendChild(child);
        });
        cardHeader.appendChild(actionsDiv);
        floatEnd.remove();
        buttonsMoved = true;
      }
    }

    // Step 3: If buttons NOT moved, keep on right of page-header
    if (!buttonsMoved && floatEnd) {
      floatEnd.classList.remove('float-end');
      floatEnd.classList.add('page-actions');
    }

    // Step 4: Rebuild page-header as flex: [title left] | [breadcrumb right]
    if (h1) h1.remove();
    if (breadcrumb) breadcrumb.remove();

    if (h1) {
      var titleDiv = document.createElement('div');
      titleDiv.className = 'page-title-only';
      titleDiv.appendChild(h1);
      container.insertBefore(titleDiv, container.firstChild);
    }

    if (breadcrumb) {
      breadcrumb.classList.add('page-breadcrumb-right');
      container.appendChild(breadcrumb);
    }

    if (!buttonsMoved && floatEnd) {
      container.appendChild(floatEnd);
    }

    container.classList.add('ph-flex');
  });
});
</script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Get current URL (without query parameters)
  const currentURL = window.location.href.split('&')[0];

  // Remove 'active' from all
  document.querySelectorAll('#top-nav .nav-link, #top-nav .dropdown-item').forEach(el => {
    el.classList.remove('active');
  });

  // Find and highlight the matching dropdown item
  let activeItem = null;
  document.querySelectorAll('#top-nav .dropdown-item').forEach(item => {
    const href = item.getAttribute('href');
    if (href && currentURL.includes(href.split('&')[0])) {
      activeItem = item;
      item.classList.add('active'); // highlight the exact page link
    }
  });

  // Highlight the parent dropdown button (if submenu clicked)
  if (activeItem) {
    let parentDropdown = activeItem.closest('.dropdown');
    if (parentDropdown) {
      let parentLink = parentDropdown.querySelector('.nav-link');
      if (parentLink) {
        parentLink.classList.add('active');
      }
    }

    // If it's a sub-dropdown, also highlight the higher parent
    let subParent = activeItem.closest('.dropdown-submenu');
    if (subParent) {
      let subParentLink = subParent.querySelector('.dropdown-toggle');
      if (subParentLink) {
        subParentLink.classList.add('active');
      }
      let higherParent = subParent.closest('.dropdown');
      if (higherParent) {
        let higherLink = higherParent.querySelector('.nav-link');
        if (higherLink) {
          higherLink.classList.add('active');
        }
      }
    }
  }

  // Also handle top-level nav items
  document.querySelectorAll('#top-nav .nav-link').forEach(link => {
    const href = link.getAttribute('href');
    if (href && currentURL.includes(href.split('&')[0])) {
      link.classList.add('active');
    }
  });
});
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const MOBILE_W = 992;

  function isMobileWidth() {
    return window.innerWidth <= MOBILE_W;
  }

  // Prevent bootstrap native toggles interfering on mobile
  function setupMobileToggles() {
    // Parent dropdown toggles and submenu toggles
    const toggles = document.querySelectorAll('#top-nav .nav-item.dropdown > .nav-link, #top-nav .dropdown-submenu > a');

    toggles.forEach(toggle => {
      // Remove any existing handler we might have added earlier
      toggle.onclick = null;

      toggle.addEventListener('click', function (e) {
        if (!isMobileWidth()) return; // keep desktop default behavior

        e.preventDefault();
        e.stopPropagation();

        // find closest dropdown or dropdown-submenu parent
        let parent = this.closest('.dropdown-submenu') || this.closest('.dropdown');

        if (!parent) return;

        // close siblings on same level
        const siblings = Array.from(parent.parentElement ? parent.parentElement.children : []);
        siblings.forEach(sib => {
          if (sib !== parent) {
            sib.classList.remove('open', 'show');
          }
        });

        // toggle this parent
        parent.classList.toggle('open');
        parent.classList.toggle('show');
      });
    });
  }

  // close all when tapping outside
  function setupDocumentClose() {
    document.addEventListener('click', function (e) {
      if (!isMobileWidth()) return;
      if (!e.target.closest('#top-nav')) {
        document.querySelectorAll('#top-nav .dropdown.open, #top-nav .dropdown.show, #top-nav .dropdown-submenu.open, #top-nav .dropdown-submenu.show').forEach(el => {
          el.classList.remove('open', 'show');
        });
      }
    });
  }

  // reset on resize
  let rtimer;
  window.addEventListener('resize', function () {
    clearTimeout(rtimer);
    rtimer = setTimeout(function () {
      // remove mobile-only classes on desktop
      if (!isMobileWidth()) {
        document.querySelectorAll('#top-nav .dropdown.open, #top-nav .dropdown.show, #top-nav .dropdown-submenu.open, #top-nav .dropdown-submenu.show').forEach(el => {
          el.classList.remove('open', 'show');
        });
      }
      // re-setup toggles (in case DOM changed)
      setupMobileToggles();
    }, 120);
  });

  // initial setup
  setupMobileToggles();
  setupDocumentClose();
});
</script>
