<nav id="column-left">
  <a href="{{ menus[0].href }}" class="sidebar-brand">
    <img src="view/image/logo.png" alt="Durga Bhavani Mart" title="Durga Bhavani Mart"/>
    <span class="sidebar-brand-text">DURGA BHAVANI MART</span>
  </a>
  <div id="navigation"><span class="fa-solid fa-bars"></span> <span class="menu-text">MENU</span></div>
  <ul id="menu">
    {% set i = 0 %}
    {% for menu in menus %}
      <li id="{{ menu.id }}" class="{% if menu.children %}has-children{% endif %}">
        {% if menu.children %}
          <a href="#collapse-{{ i }}" data-bs-toggle="collapse" class="parent collapsed" data-toggle="menu-{{ i }}"><i class="{{ menu.icon }}"></i> <span class="menu-text">{{ menu.name }}</span></a>
          <ul id="collapse-{{ i }}" class="collapse">
            {% for children_1 in menu.children %}
              {% if children_1.children %}
                <li class="has-children">
                  <a href="#collapse-{{ i }}-{{ loop.index }}" data-bs-toggle="collapse" class="parent collapsed" data-toggle="menu-{{ i }}-{{ loop.index }}"><span class="menu-text">{{ children_1.name }}</span></a>
                  <ul id="collapse-{{ i }}-{{ loop.index }}" class="collapse">
                    {% for children_2 in children_1.children %}
                      <li><a href="{{ children_2.href }}"><span class="menu-text">{{ children_2.name }}</span>{% if children_2.badge %}<span class="badge">{{ children_2.badge }}</span>{% endif %}</a></li>
                    {% endfor %}
                  </ul>
                </li>
              {% else %}
                <li><a href="{{ children_1.href }}"><span class="menu-text">{{ children_1.name }}</span>{% if children_1.badge %}<span class="badge">{{ children_1.badge }}</span>{% endif %}</a></li>
              {% endif %}
            {% endfor %}
          </ul>
        {% else %}
          <a href="{{ menu.href ? menu.href : 'javascript:void(0);' }}"><i class="{{ menu.icon }}"></i> <span class="menu-text">{{ menu.name }}</span>{% if menu.badge %}<span class="badge">{{ menu.badge }}</span>{% endif %}</a>
        {% endif %}
      </li>
      {% set i = i + 1 %}
    {% endfor %}
  </ul>
<script>
$('#navigation').css('cursor', 'pointer').on('click', function(e) {
    e.preventDefault();
    if ($('#column-left').hasClass('active')) {
        $('#column-left').removeClass('active');
        $('body').addClass('sidebar-collapsed');
    } else {
        $('#column-left').addClass('active');
        $('body').removeClass('sidebar-collapsed');
    }
});

function getRouteFromHref(href) {
    if (!href) return null;

    try {
        return new URL(href, window.location.origin).searchParams.get('route');
    } catch (e) {
        return null;
    }
}

function clearMenuActiveState() {
    $('#menu li').removeClass('active');
    $('#menu ul.collapse').removeClass('show');
    $('#menu a.parent').addClass('collapsed');
}

function setActiveByCurrentRoute() {
    var urlParams = new URLSearchParams(window.location.search);
    var currentRoute = urlParams.get('route');
    if (urlParams.has('pos_product')) {
        currentRoute = 'extension/purpletree_pos/pos/posproduct';
    } else if (urlParams.has('posagent')) {
        currentRoute = 'extension/purpletree_pos/pos/posagent';
    }
    var $activeLink = $();

    clearMenuActiveState();

    if (!currentRoute) return;

    // 1. Find exact matching link anywhere in menu.
    $('#menu a[href]').each(function() {
        var route = getRouteFromHref($(this).attr('href'));

        if (route === currentRoute) {
            $activeLink = $(this);
            return false;
        }
    });

    // 2. Find controller-level match (part before first dot '.') where the route is exactly equal to the controller name.
    if (!$activeLink.length) {
        var currentController = currentRoute.split('.')[0];
        $('#menu a[href]').each(function() {
            var route = getRouteFromHref($(this).attr('href'));

            if (route === currentController) {
                $activeLink = $(this);
                return false;
            }
        });
    }

    // 3. Find prefix-level match where routes share the same controller name.
    if (!$activeLink.length) {
        var currentController = currentRoute.split('.')[0];
        $('#menu a[href]').each(function() {
            var route = getRouteFromHref($(this).attr('href'));

            if (route && route.split('.')[0] === currentController) {
                $activeLink = $(this);
                return false;
            }
        });
    }

    if (!$activeLink.length) return;

    // Highlight only the exact selected row.
    $activeLink.parent('li').addClass('active');

    // Open and highlight its parent chain (without highlighting unrelated items).
    $activeLink.parents('ul.collapse').each(function() {
        $(this).addClass('show');
        var $ownerLi = $(this).closest('li.has-children');
        $ownerLi.addClass('active');
        $ownerLi.children('a.parent').removeClass('collapsed');
    });
}

setActiveByCurrentRoute();

// Keep only one top-level section open/active while toggling dropdowns.
$('#menu > li.has-children > a.parent').on('click', function() {
    var $ownerLi = $(this).parent('li');

    $('#menu > li').not($ownerLi).removeClass('active');
    $('#menu > li > ul.collapse').not($ownerLi.children('ul.collapse')).removeClass('show');
    $('#menu > li > a.parent').not(this).addClass('collapsed');

    $ownerLi.addClass('active');
});

$('.collapse').on('hide.bs.collapse', function() {
    var $ownerLi = $(this).closest('li.has-children');

    // If this section contains current page, keep it active.
    if ($(this).find('li.active').length) return;

    $ownerLi.removeClass('active');
    $ownerLi.children('a.parent').addClass('collapsed');
});
</script>
</nav>
