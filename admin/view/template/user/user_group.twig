{{ header }}{{ column_left }}
<div id="content">
	<div class="page-header" style="padding-top: 24px; padding-bottom: 24px; margin-bottom: 0;">
		<div class="container-fluid d-flex justify-content-between align-items-center">
			<h2 style="margin: 0; font-size: 20px; font-weight: 600; line-height: 28px; color: var(--bs-heading-color) !important; font-family: 'Outfit', 'Inter', sans-serif;">{{ heading_title }}</h2>
			<ol class="breadcrumb" style="margin: 0; padding: 0; --bs-breadcrumb-divider: '>';">
				{% for breadcrumb in breadcrumbs %}
				  {% if loop.last %}
				    <li class="breadcrumb-item active" style="color: var(--bs-heading-color) !important;">{{ breadcrumb.text }}</li>
				  {% else %}
				    <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}" style="color: #64748b !important; text-decoration: none;">{{ breadcrumb.text }}</a></li>
				  {% endif %}
				{% endfor %}
			</ol>
		</div>
	</div>
	<div class="container-fluid">
		<div class="card">
			<div class="card-header d-flex justify-content-between align-items-center">
				<span style="color: var(--bs-heading-color) !important; font-weight: 600; font-family: 'Outfit', 'Inter', sans-serif; font-size: 15px; display: inline-flex; align-items: center;"><i class="fa-solid fa-list" style="margin-right: 8px;"></i> {{ heading_title }} List</span>
				<div class="d-flex gap-2 align-items-center">
					<a href="{{ add }}" data-bs-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary btn-custom-add"><i class="fa-solid fa-plus"></i> Add</a>
					<button type="submit" form="form-user-group" formaction="{{ delete }}" data-bs-toggle="tooltip" title="{{ button_delete }}" onclick="if ($('input[name*=\'selected\']:checked').length == 0) { alert('Please select at least one item to delete.'); return false; } return confirm('{{ text_confirm }}');" class="btn btn-danger btn-custom-delete"><i class="fa-solid fa-trash-can text-white"></i> Delete</button>
				</div>
			</div>
			<div id="user-group" class="card-body">{{ list }}</div>
		</div>
	</div>
</div>
<script type="text/javascript"><!--
$('#user-group').on('click', 'thead a, .pagination a', function(e) {
    e.preventDefault();

    $('#user-group').load(this.href);
});
//--></script>
{{ footer }}